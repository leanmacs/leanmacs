                    #[(⟨3⟩, rect 0 448 640 32)] &&
                short.tiled == rect 0 0 640 0 &&
                short.rects.back? == some (⟨3⟩, rect 0 0 640 10) &&
                alone.rects == #[(⟨1⟩, rect 0 0 640 468)] &&
                aloneAsking.frame.focused == ⟨3⟩ &&
                aloneAsking.rects == #[(⟨1⟩, rect 0 0 640 448), (⟨3⟩, rect 0 448 640 32)] &&
