            followedFrom sixteen 10 5 99 (startOf rows 8) (startOf rows 11) ==
              some { moved := true, shown := rows.extract 9 14, index := some 2 } &&
            followFrom sixteen 10 5 99 (startOf rows 8) (startOf rows 10) == some none &&
