/-- A rectangle at `x`, `y`, `width` across and `height` down. -/
def rectAt (x y width height : Nat) : Rect :=
  { x, y, width, height }

/-- The initial state in a frame of `size`, with `heights` as the heights
the display last answered. -/
def sizedState (size : Size) (heights : Display.Heights := default) : Option EditorState :=
  (onTextModel (EditorState.initial size)).map ({ · with heights })

/-- The checks of how the views and the minibuffer's place are sized by the
heights the display answers (`EditorState.rects`, `EditorState.bottomRow`,
`Scroll.Area.ofRect`), and of what `Loop.publish` keeps of them; and that
opening a prompt clears the echo, as Vim does (`EditorState.openPrompt`).
The heights are the state's: a check sets them as the display would. -/
def heightChecks : List Check :=
  let sixteen : Display.Heights := { text := 16, status := 16, message := 16 }
  let odd : Display.Heights := { text := 24, status := 20, message := 28 }
  [{  name :=
        "with no prompt open a window of a 640 by 480 frame ends above the bottom row, 640 by 464, and is asked about with its height less its status row"
      run :=
        pure <|
          match sizedState ⟨640, 480⟩ sixteen with
          | none => false
          | some state =>
            state.rects == #[(⟨0⟩, rectAt 0 0 640 464)] && state.bottomRow ⟨0⟩ == 16 &&
              Scroll.Area.ofRect ⟨3⟩ (rectAt 0 0 640 464) (state.bottomRow ⟨0⟩) ==
                { snapshot := ⟨3⟩, width := 640, height := 448 } },
    { name :=
        "with a prompt open the minibuffer's place is a text row and the bottom row, and the minibuffer's view is asked about with its height less the bottom row"
      run :=
        pure <|
          match sizedState ⟨640, 480⟩ sixteen with
          | none => false
          | some state =>
            match prompted state with
            | (.ok view, asking) =>
              asking.rects == #[(⟨0⟩, rectAt 0 0 640 448), (view, rectAt 0 448 640 32)] &&
                asking.bottomRow view == 16 &&
                Scroll.Area.ofRect ⟨3⟩ (rectAt 0 448 640 32) (asking.bottomRow view) ==
                  { snapshot := ⟨3⟩, width := 640, height := 16 }
            | _ => false },
    { name :=
        "with heights of 24, 20 and 28 a 640 by 480 frame gives a window of 452 asked about at 432, and a prompt's place of 52 asked about at 24"
      run :=
        pure <|
          match sizedState ⟨640, 480⟩ odd with
          | none => false
          | some state =>
            let window := rectAt 0 0 640 452
            state.rects == #[(⟨0⟩, window)] &&
              (Scroll.Area.ofRect ⟨3⟩ window (state.bottomRow ⟨0⟩)).height == 432 &&
              match prompted state with
              | (.ok view, asking) =>
                let place := rectAt 0 428 640 52
                asking.rects == #[(⟨0⟩, rectAt 0 0 640 428), (view, place)] &&
                  (Scroll.Area.ofRect ⟨3⟩ place (asking.bottomRow view)).height == 24
              | _ => false },
    { name := "a frame of 0 by 0 gives views of 0 by 0, with a prompt open or not"
      run :=
        pure <|
          match sizedState ⟨0, 0⟩ sixteen with
          | none => false
          | some state =>
            state.rects == #[(⟨0⟩, rectAt 0 0 0 0)] &&
              match prompted state with
              | (.ok view, asking) =>
                asking.rects == #[(⟨0⟩, rectAt 0 0 0 0), (view, rectAt 0 0 0 0)]
              | _ => false },
    { name := "a publish keeps the heights the display answered, for the commands until the next"
      run :=
        pure <|
          match evilDriver "|abc" with
          | none => false
          | some driver =>
            -- The display model's cells are 1 by 1, so its heights are 1.
            (viewResized driver ⟨40, 30⟩).loop.state.heights ==
              { text := 1, status := 1, message := 1 } },
    { name := "opening a prompt clears the echo, and an open that is refused leaves it as it was"
      run :=
        pure <|
          match sizedState ⟨640, 480⟩ with
          | none => false
          | some state =>
            let said := { state with echo := "before" }
            match prompted said with
            | (.ok _, asking) =>
              asking.echo == "" &&
                match prompted { asking with echo := "before" } with
                | (.error (.alreadyOpen _), refused) => refused.echo == "before"
                | _ => false
            | _ => false }]

/-- The registry of the frame command checks: the frame's commands, and the
ex line's, whose `quit` the frame's `s-q` names, and the frame's bindings,
with the menu bar's bindings, registered for the owner `compiled`, as a
host registers them, and `config` as config's bindings and `commands` as
config's commands. -/
def frameRegistry (config : Array Config.KeyBinding := #[])
    (commands : Array Config.Registration := #[]) : Config.Registry :=
  (((({} : Config.Registry).replace .compiled
                (FrameCommands.commands ++ Ex.commands)).replaceBindings
            .compiled (FrameCommands.bindings ++ Menu.bindings)).replaceBindings
        .config config).replace
    .config commands

/-- What a step of the frame command checks is handed: the active keymaps
`registry` makes for the test scheme from the loop's state, its plain
commands and those given their call, and the menu bar that ships with its
key equivalents filled from `registry`, as a host's are. -/
def frameKeys (registry : Config.Registry) : Loop.Keys TestScheme.scheme :=
  { maps := registry.activeMaps TestScheme.scheme
    command? := fun name =>
      match registry.find? name with
      | some { registration := { action := .plain run, .. }, .. } =>
        some fun _ => do
          run
          return none
      | some { registration := { action := .call run, .. }, .. } =>
        some fun call => do
          run call
          return none
      | _ => none
    menu := some (registry.menuOf Menu.standard) }

/-- A driver of the frame command checks over the initial state, with the
keys of `registry`; `none` if making the state was refused. With `held`
the scratch buffer holds a file, made up and never loaded, so that an edit
of it is an unsaved change. -/
def frameDriver (registry : Config.Registry := frameRegistry) (held : Bool := false) :
    Option TestDriver :=
  let start : TextM EditorState := do
    let state ← EditorState.initial ⟨640, 480⟩
    if held then
      return (state.attachFile ⟨0⟩ "/files/note.txt" { seconds := 0, nanoseconds := 0, size := 0 }
            .lf).2
    return state
  (Loop.Driver.over (frameKeys registry) driverJobs start editorModel).toOption

/-- The window's word that it is 640 by 480 at scale 1, in fullscreen or not. -/
def resizedTo (fullscreen : Bool) : Event :=
  .resize { width := 640, height := 480, scale := 1.0, fullscreen }

/-- What `driver`'s display model was asked of the window, and whether the
frame last said it is in fullscreen, after `events`; `none` without a
driver. -/
def framed (driver : Option TestDriver) (events : List Event) :
    Option (Array Display.FrameRequest × Bool) :=
  driver.map fun driver =>
    let fed := (fedTo driver events).1
    (fed.model.display.asked, fed.loop.state.frame.fullscreen)

/-- The checks of the frame's commands (`Editor/FrameCommands.lean`,
`Editor/FrameCommands/Compiled.lean`) and of the frame's last reported
fullscreen state, on the loop's driver over the editor's models and the
test scheme, with the registry's active keymaps. -/
def frameCommandChecks : List Check :=
  [{  name :=
        "a resize in fullscreen sets the frame's last reported state, and a resize out of it clears it"
      run :=
        pure <|
          match frameDriver with
          | none => false
          | some driver =>
            let entered := (fedTo driver [resizedTo true]).1
            let left := (fedTo entered [resizedTo false]).1
            !driver.loop.state.frame.fullscreen && entered.loop.state.frame.fullscreen &&
              !left.loop.state.frame.fullscreen &&
              left.model.display.asked.isEmpty },
    { name :=
        "toggle-fullscreen, run with the window last reported windowed, asks the display to enter fullscreen and nothing else, and leaves the frame's state as it was"
      run := pure (framed frameDriver (presses "C-s-f") == some (#[.enterFullscreen], false)) },
    { name := "toggle-fullscreen, run with the window last reported in fullscreen, asks to leave it"
      run :=
        pure
          (framed frameDriver (resizedTo true :: presses "C-s-f") ==
            some (#[.leaveFullscreen], true)) },
    { name :=
        "C-s-f runs toggle-fullscreen: pressed twice with a resize in fullscreen between, it asks to enter and then to leave"
      run :=
        pure
          (framed frameDriver (presses "C-s-f" ++ [resizedTo true] ++ presses "C-s-f") ==
            some (#[.enterFullscreen, .leaveFullscreen], true)) },
    { name := "s-m runs minimise-window, which asks the display to minimise the window"
      run := pure (framed frameDriver (presses "s-m") == some (#[.minimise], false)) },
    { name :=
        "s-q runs quit: with a buffer that holds a file edited, it is refused with the quit command's message and the driver goes on; with nothing unsaved it stops the driver"
      run :=
        pure <|
          match frameDriver (held := true) with
          | none => false
          | some driver =>
            let (refused, _) := fedTo driver ([.commit "x"] ++ presses "s-q")
            let (left, steps) := fedTo driver (presses "s-q")
            !refused.stopped && !refused.loop.state.quitting &&
              echoOf refused == some (Ex.notQuitting (.unsaved "scratch")) &&
              left.stopped &&
              steps.back?.join.map (·.next) == some .stop },
    { name :=
        "the compiled bindings are C-s-f to toggle-fullscreen, s-m to minimise-window and s-q to quit, and config's binding of C-s-f is the one that runs while config binds it"
      run :=
        let rebound :=
          frameRegistry #[{ keys := keys "C-s-f", command := FrameCommands.minimiseName }]
        pure
          (FrameCommands.bindings ==
              #[{ keys := keys "C-s-f", command := FrameCommands.toggleFullscreenName },
                { keys := keys "s-m", command := FrameCommands.minimiseName },
                { keys := keys "s-q", command := Ex.quitName }] &&
            FrameCommands.toggleFullscreenName == "toggle-fullscreen" &&
            FrameCommands.minimiseName == "minimise-window" &&
            FrameCommands.commands.map (·.name) == #["toggle-fullscreen", "minimise-window"] &&
            framed (frameDriver rebound) (presses "C-s-f") == some (#[.minimise], false)) }]

/-- Active keymaps, for every view, that bind each key string of `table` to
the command name beside it, as config's `bindKey` binds one. -/
def windowMaps (table : List (String × String)) : EditorState → ViewId → List (Keymap Vim.Bound) :=
  fun _ _ => [Vim.Default.keymap (table.map fun (text, name) => (text, .command { name }))]

/-- What a step of the window checks is handed: evil's commands, the
minibuffer's, the ex line's and the window commands, `layout` as config's
layout, and `maps` as the active keymaps, none unless a check names them,
so the window commands are reached by the keys the Vim scheme that ships
binds. -/
def windowHanded (layout : Layout)
    (maps : EditorState → ViewId → List (Keymap Vim.Bound) := fun _ _ => []) :
    Loop.Keys Vim.Default.scheme :=
  { evilHanded (Ex.commands ++ WindowCommands.commands) with
    layout := some layout, maps }

/-- A driver of the window checks over `windowsUnder count layout`, with
config's layout `layout` already applied and the window `focus` focused, on
the editor's models in cells 16 pixels tall, so that the tiled area of the
frame of 640 by 480 is 640 by 464. -/
def windowDriver (count : Nat) (layout : Layout) (focus : Nat := 0)
    (handed : Loop.Keys Vim.Default.scheme := windowHanded layout) : Option EvilDriver :=
  let start : TextM EditorState := do
    let state ← windowsUnder count layout
    return { state with
        frame :=
          { state.frame with
            chosen := some layout, focused := ⟨focus⟩ } }
  (Loop.Driver.over handed (fun _ => none) start
      (.over { advance := 8, lineHeight := 16 })).toOption

/-- The state of the window driver over `count` windows under `layout`,
`focus` focused, once the keys `typed` name were pressed. -/
def windowsAfter (count : Nat) (layout : Layout) (typed : String) (focus : Nat := 0) :
    Option EditorState :=
  (windowDriver count layout focus).map fun driver => (evilFed driver typed).loop.state

/-- The window list, as indices, and the focus of `state`. -/
def windowOrder (state : EditorState) : List Nat × Nat :=
  (state.frame.windows.toList.map (·.index), state.frame.focused.index)

/-- The rectangles of `state`'s windows, each as its view's index and its
x, y, width and height. -/
def windowRects (state : EditorState) : List (Nat × Nat × Nat × Nat × Nat) :=
  state.rects.toList.map fun (view, rect) => (view.index, rect.x, rect.y, rect.width, rect.height)

/-- The checks of the window commands (`Editor/WindowCommands.lean`), by
key, on the loop's driver over the editor's models, under the Vim scheme
that ships, with evil's, the minibuffer's, the ex line's and the window
commands handed: Vim 9.1's `C-w` behaviours under the manual split layout,
the reorders, zoom and resizes under master-and-stack, focus by direction
under the three layouts, and the refusals in the echo area. -/
def windowCommandChecks : List Check :=
  let manual (count : Nat) (typed : String) (focus : Nat := 0) : Option EditorState :=
    windowsAfter count Layout.manual typed focus
  [{  name :=
        "criterion 1, C-w s: two windows on the same buffer with equal markers at first, the new one above and focused, and the windows of the column equal in height; three from one window at 640 by 464 give four rows of 116"
      run :=
        pure <|
          let split := (windowDriver 1 Layout.manual).map (evilFed · "C-w s")
          match split, manual 1 "C-w s C-w s C-w s" with
          | some split, some thrice =>
            let state := split.loop.state
            windowOrder state == ([1, 0], 1) &&
              windowRects state == [(1, 0, 0, 640, 232), (0, 0, 232, 640, 232)] &&
              state.windows.all (·.buffer == ⟨0⟩) &&
              evilSelection split ⟨1⟩ == evilSelection split ⟨0⟩ &&
              (evilSelection split ⟨1⟩).isSome &&
              (windowRects thrice).map (·.2.2.2.2) == [116, 116, 116, 116] &&
              thrice.wellFormed
          | _, _ => false },
    { name :=
        "criterion 1, C-w v: the new window on the left and focused; two give three columns equal to a pixel; under a column split, C-w s then C-w v, the heights do not change"
      run :=
        pure <|
          match manual 1 "C-w v", manual 1 "C-w v C-w v", manual 1 "C-w s C-w v" with
          | some once, some twice, some under =>
            windowOrder once == ([1, 0], 1) &&
              windowRects once == [(1, 0, 0, 320, 464), (0, 320, 0, 320, 464)] &&
              windowRects twice ==
                [(2, 0, 0, 213, 464), (1, 213, 0, 213, 464), (0, 426, 0, 214, 464)] &&
              windowRects under ==
                [(2, 0, 0, 320, 232), (1, 320, 0, 320, 232), (0, 0, 232, 640, 232)]
          | _, _, _ => false },
    { name :=
        "criterion 1, C-w C-n (Vim's CTRL-W n): a new window above, focused, on a new empty buffer with no file; the old window keeps its buffer"
      run :=
        pure <|
          match (windowDriver 1 Layout.manual).map (evilFed · "C-w C-n") with
          | none => false
          | some driver =>
            let state := driver.loop.state
            let made := state.window? ⟨1⟩
            windowOrder state == ([1, 0], 1) &&
              windowRects state == [(1, 0, 0, 640, 232), (0, 0, 232, 640, 232)] &&
              (state.window? ⟨0⟩).map (·.buffer) == some ⟨0⟩ &&
              made.any (·.buffer != ⟨0⟩) &&
              (made.bind fun window => state.buffer? window.buffer).any fun buffer =>
                buffer.file.isNone &&
                  (driver.model.texts.texts[buffer.text.index]?).join.map (·.contents) == some "" },
    { name :=
        "criterion 1 and 5, C-w C-c (Vim's CTRL-W c): the window leaves the list and the tree, and the windows of its column are equal again; on the last window it is refused, and the echo area says why"
      run :=
        pure <|
          match manual 1 "C-w s C-w s C-w C-c", manual 1 "C-w C-c" with
          | some closed, some last =>
            windowOrder closed == ([1, 0], 1) &&
              windowRects closed == [(1, 0, 0, 640, 232), (0, 0, 232, 640, 232)] &&
              closed.wellFormed &&
              windowOrder last == ([0], 0) &&
              last.echo == s!"{WindowCommands.closeName}: {LayoutRefusal.onlyWindow.describe}"
          | _, _ => false },
    { name :=
        "C-w q: with several windows it closes the window as C-w C-c does; on the last window it asks the editor to quit"
      run :=
        pure <|
          match manual 1 "C-w s C-w q", manual 1 "C-w q" with
          | some closed, some last =>
            windowOrder closed == ([0], 0) && !closed.quitting && last.quitting
          | _, _ => false },
    { name :=
        "C-w o: every other window is closed, and the window it was run in takes the whole tiled area; with one window it says so"
      run :=
        pure <|
          match manual 1 "C-w s C-w v C-w o", manual 1 "C-w o" with
          | some only, some alone =>
            windowOrder only == ([2], 2) && windowRects only == [(2, 0, 0, 640, 464)] &&
              only.wellFormed &&
              alone.echo == WindowCommands.alreadyOnly
          | _, _ => false },
    { name :=
        "criterion 1 and 4, C-w h j k l under manual splits: in a 2 by 2 grid each direction reaches the neighbour and at an edge nothing changes; in a column beside a row, left from the column reaches the top of the row; a count of 2 goes two windows"
      run :=
        pure <|
          let grid :=
            Splits.split .rows 1 1 (.split .columns 1 1 .tile .tile)
              (.split .columns 1 1 .tile .tile)
          let beside := Splits.split .columns 1 1 (.split .rows 1 1 .tile .tile) .tile
          let row := Splits.even .columns 3
          let focus (count : Nat) (tree : Splits) (typed : String) (start : Nat := 0) :
            Option Nat :=
            (windowsAfter count (.splits tree) typed start).map (·.frame.focused.index)
          focus 4 grid "C-w l" == some 1 && focus 4 grid "C-w l C-w j" == some 3 &&
            focus 4 grid "C-w l C-w j C-w h" == some 2 &&
            focus 4 grid "C-w l C-w j C-w h C-w k" == some 0 &&
            focus 4 grid "C-w h C-w k" == some 0 &&
            (windowsAfter 4 (.splits grid) "C-w h").any (·.echo.isEmpty) &&
            focus 3 beside "C-w l" == some 2 &&
            focus 3 beside "C-w h" 2 == some 0 &&
            focus 3 beside "C-w j" == some 1 &&
            focus 3 row "2 C-w l" == some 2 },
    { name :=
        "criterion 1, C-w C-w (Vim's CTRL-W w) and C-w W: the next and the previous window in the tree's order, the last wrapping to the first and the first to the last; with a count, the Nth window"
      run :=
        pure <|
          let focus (typed : String) : Option Nat := (manual 3 typed).map (·.frame.focused.index)
          focus "C-w C-w" == some 1 && focus "C-w C-w C-w C-w C-w C-w" == some 0 &&
            focus "3 C-w C-w" == some 2 &&
            focus "C-w W" == some 2 &&
            focus "2 C-w W" == some 1 },
    { name := "criterion 1, C-w t and C-w b: the first and the last window of the tree's order"
      run :=
        pure <|
          (manual 3 "C-w b").map (·.frame.focused.index) == some 2 &&
            (manual 3 "C-w b C-w t").map (·.frame.focused.index) == some 0 },
    { name :=
        "criterion 1, C-w C-p (Vim's CTRL-W p): after C-w s it goes back to the window split, and again forth; with no last window it is refused, and the echo area says why"
      run :=
        pure <|
          match manual 1 "C-w s C-w C-p", manual 1 "C-w s C-w C-p C-w C-p", manual 1 "C-w C-p" with
          | some back, some forth, some missing =>
            back.frame.focused == ⟨0⟩ && forth.frame.focused == ⟨1⟩ &&
              missing.echo ==
                s!"{WindowCommands.lastName}: {LayoutRefusal.noPreviousWindow.describe}"
          | _, _, _ => false },
    { name :=
        "criterion 1, C-w =: every split back to its slot counts, so a column beside a column gives equal columns, and equal rows in each"
      run :=
        pure <|
          let tree :=
            Splits.split .columns 7 3 (.split .rows 1 4 .tile .tile) (.split .rows 2 1 .tile .tile)
          (windowsAfter 4 (.splits tree) "C-w =").map windowRects ==
            some
              [(0, 0, 0, 320, 232), (1, 0, 232, 320, 232), (2, 320, 0, 320, 232),
                (3, 320, 232, 320, 232)] },
    { name :=
        "C-w x exchanges the window with the next and puts the focus in the other window; C-w r and C-w R rotate a row of windows, the focus staying in its window"
      run :=
        pure <|
          let row := Layout.splits (Splits.even .columns 3)
          (manual 3 "C-w x").map windowOrder == some ([1, 0, 2], 1) &&
            (windowsAfter 3 row "C-w r").map windowOrder == some ([2, 0, 1], 0) &&
            (windowsAfter 3 row "C-w R").map windowOrder == some ([1, 2, 0], 0) },
    { name :=
        "criterion 3, by key under master-and-stack from views 0, 1 and 2 focused on 2: C-w m makes 2 main, C-w M demotes it again, C-w r rotates the stack and C-w R back; C-w z leaves one view in the scene, the focused one, over the tiled area, and C-w z again gives the three views and master-and-stack back"
      run :=
        pure <|
          let after (typed : String) : Option (List Nat × Nat) :=
            (windowsAfter 3 Layout.default typed 2).map windowOrder
          let scene (typed : String) : Option (List (Nat × Rect) × Layout) :=
            (windowDriver 3 Layout.default 2).bind fun driver =>
              let driver := evilFed driver typed
              driver.model.display.scenes.back?.map fun scene =>
                (scene.views.toList.map fun view => (view.id.index, view.rect),
                  driver.loop.state.frame.layout)
          let tiled : Rect := { x := 0, y := 0, width := 640, height := 464 }
          after "C-w m" == some ([2, 0, 1], 2) && after "C-w m C-w M" == some ([0, 2, 1], 2) &&
            after "C-w m C-w M C-w r" == some ([0, 1, 2], 2) &&
            after "C-w m C-w M C-w r C-w R" == some ([0, 2, 1], 2) &&
            scene "C-w z" == some ([(2, tiled)], .monocle) &&
            (scene "C-w z C-w z").map (fun (views, layout) => (views.map (·.1), layout)) ==
              some ([0, 1, 2], Layout.default) },
    { name :=
        "resize by key under master-and-stack: C-w > on main makes the share 55 and on a stack window 45, with a count 60; C-w , and C-w . change main's count"
      run :=
        pure <|
          let layout (typed : String) (focus : Nat := 0) : Option Layout :=
            (windowsAfter 2 Layout.default typed focus).map (·.frame.layout)
          layout "C-w >" == some (.masterStack { share := 55 }) &&
            layout "C-w >" 1 == some (.masterStack { share := 45 }) &&
            layout "2 C-w >" == some (.masterStack { share := 60 }) &&
            layout "C-w <" == some (.masterStack { share := 45 }) &&
            layout "C-w ," == some (.masterStack { count := 2 }) &&
            layout "C-w , C-w ." == some Layout.default },
    { name :=
        "criterion 4, by key: under master-and-stack C-w l from main reaches the top of the stack, C-w j walks it and C-w h comes back to main; under monocle no window is in any direction and the focus stays"
      run :=
        pure <|
          let focus (layout : Layout) (typed : String) : Option Nat :=
            (windowsAfter 3 layout typed).map (·.frame.focused.index)
          focus Layout.default "C-w l" == some 1 && focus Layout.default "C-w l C-w j" == some 2 &&
            focus Layout.default "C-w l C-w j C-w h" == some 0 &&
            focus .monocle "C-w l" == some 0 &&
            focus .monocle "C-w j" == some 0 },
    { name :=
        "criterion 6, on the models, over two windows side by side: with no active keymaps C-w in insert state deletes the word before the bar and l after it is text, the view staying in insert state and focused; with active keymaps that bind the window keys, as a config's bindKey binds them, C-w l and C-w h in insert state focus the window on the right and come back without leaving insert state, and typing goes on where it was"
      run :=
        pure <|
          let stateOf (driver : EvilDriver) (view : Nat) : String :=
            (driver.loop.input : Vim.State).stateOf Vim.Default.states ⟨view⟩
          let bound := windowHanded Layout.default (windowMaps Vim.Default.windowKeys)
          match (windowDriver 2 Layout.default).map (evilFed · "i h e l l o SPC w o r l d C-w l"),
            windowDriver 2 Layout.default 0 bound with
          | some plain, some driver =>
            let typed := evilFed driver "i a b C-w l"
            let back := evilFed typed "C-w h"
            let more := evilFed back "c"
            evilText plain == some "hello l" && plain.loop.state.frame.focused == ⟨0⟩ &&
              stateOf plain 0 == "insert" &&
              typed.loop.state.frame.focused == ⟨1⟩ &&
              stateOf typed 0 == "insert" &&
              back.loop.state.frame.focused == ⟨0⟩ &&
              stateOf back 0 == "insert" &&
              evilText more == some "abc" &&
              stateOf more 0 == "insert"
          | _, _ => false },
    { name :=
        "window-close on the minibuffer's view, by a config's binding that holds there, is refused with ofMinibuffer, the echo area says why, and the prompt stays open"
      run :=
        pure <|
          let handed :=
            windowHanded Layout.manual (windowMaps [("C-w C-c", WindowCommands.closeName)])
          match (windowDriver 1 Layout.manual 0 handed).map (evilFed · ": C-w C-c") with
          | none => false
          | some driver =>
            let state := driver.loop.state
            state.prompt.isSome &&
              state.echo ==
                s!"{WindowCommands.closeName}: {(LayoutRefusal.ofMinibuffer ⟨0⟩).describe}" }]

/-- The checks of a request of the window through the display interface,
on its model. -/
def frameDisplayChecks : List Check :=
  [{  name :=
        "a frame request is recorded by the model in order and changes no answer of rows, a move or the heights"
      run := do
        let query : Display.RowsQuery := { snapshot := ⟨0⟩, width := 2, height := 4, anchor := 0 }
        let move : Display.MoveQuery :=
          { snapshot := ⟨0⟩, width := 2, position := 0, lines := 1, goal := none }
        let ask : DisplayM _ := do
          return (← Display.rowsShown query, ← Display.linesFrom move, ← Display.heights)
        let program : DisplayM _ := do
          Display.askFrame .enterFullscreen
          Display.askFrame .minimise
          let answers ← ask
          Display.askFrame .leaveFullscreen
          return answers
        let (asked, model) := program.runModel (displayOver ["abcd"])
        let (unasked, plain) := ask.runModel (displayOver ["abcd"])
        return asked.toOption == unasked.toOption && asked.toOption.isSome &&
            model.asked == #[.enterFullscreen, .minimise, .leaveFullscreen] &&
            plain.asked.isEmpty &&
            model.scenes.isEmpty }]

/-- The title of the last scene `driver`'s display recorded. -/
def titleOf (driver : TestDriver) : Option String :=
  driver.model.display.scenes.back?.map (·.title)

/-- The checks of the scene's title: the selected buffer's name. -/
def titleChecks : List Check :=
  [{  name :=
        "the scene's title is the selected buffer's name: scratch on the initial state, the file's name once one is opened, and the asking window's buffer's while a prompt is open, not the minibuffer's"
      run :=
        pure <|
          match newDriver, noteOpen, minibufferDriver with
          | some driver, some opened, some asking =>
            let started := (fedTo driver [resizedTo false]).1
            let prompting := (fedTo asking (presses "C-c a")).1
            let minibuffer := do
              let view ← prompting.loop.state.minibufferView?
              let target ← prompting.loop.state.target? view
              return target.buffer.name
            EditorState.title started.loop.state == "scratch" &&
              titleOf started == some "scratch" &&
              titleOf opened == some "note.txt" &&
              prompting.loop.state.prompt.isSome &&
              minibuffer.isSome &&
              minibuffer != some "scratch" &&
              titleOf prompting == some "scratch" &&
              EditorState.title EditorState.none == ""
          | _, _, _ => false }]

/-- The menu bar the frame driver over `registry` publishes once the window
has said its size; `none` without one. -/
def menuShown (registry : Config.Registry) : Option Menu := do
  let driver ← frameDriver registry
  let scene ← (fedTo driver [resizedTo false]).1.model.display.scenes.back?
  scene.menu

/-- The key equivalent of `character` with `modifiers` held, the system key
alone unless told. -/
def equivalent (character : Char) (modifiers : Modifiers := { superKey := true }) :
    Option KeyEquivalent :=
  some { character, modifiers }

/-- The Vim scheme of the menu's run-table checks: the default states, with
normal state's run table holding `t-enter`, run as `visual-line` entering
that state, and `t-fail`, run as itself entering it too. -/
def menuRunScheme : InputScheme :=
  let enter (name : String) : Vim.Edit := .run { name, enters := some "visual-line" } none none
  Vim.scheme
    (Vim.Default.states.register
      { Vim.Default.states.initial with
        runs := [("t-enter", enter "visual-line"), ("t-fail", enter "t-fail")] })

/-- A driver of the menu's run-table checks over the text and cursor
`fixture` says, with evil's commands and `t-fail`, which gives up. -/
def menuRunDriver (fixture : String) : Option (Loop.Driver menuRunScheme) :=
  let (contents, head) := barred fixture
  let fail : Dispatched := fun _ => giveUp "failed"
  let keys : Loop.Keys menuRunScheme :=
    { command? := (evilHanded (commands := [("t-fail", fail)])).command? }
  (Loop.Driver.over keys (fun _ => none) (evilState contents head) editorModel).toOption

/-- The selection of view 0 of `driver`, as the text model has it. -/
def menuRunSelection (driver : Loop.Driver menuRunScheme) : Option Selection := do
  let target ← driver.loop.state.target? ⟨0⟩
  (target.selection.runModel driver.model.texts).1.toOption

/-- The key equivalents the compiled bindings give the menu's commands. -/
def compiledEquivalents : String → Option KeyEquivalent
  | "open-file" => equivalent 'o'
  | "save-buffer" => equivalent 's'
  | "undo" => equivalent 'z'
  | "redo" => equivalent 'Z'
  | "clipboard-cut" => equivalent 'x'
  | "clipboard-copy" => equivalent 'c'
  | "clipboard-paste" => equivalent 'v'
  | "select-all" => equivalent 'a'
  | "minimise-window" => equivalent 'm'
  | "toggle-fullscreen" => equivalent 'f' { control := true, superKey := true }
  | _ => none

/-- The key equivalent `menu`'s item that runs `command` shows; `none` when
no item runs it. -/
def keyShown (menu : Menu) (command : String) : Option (Option KeyEquivalent) :=
  menu.menus.findSome? fun submenu =>
    submenu.items.findSome? fun
      | .item _ key (.command name) => if name == command then some key else none
      | _ => none

/-- The registry of nothing but the binding of `text` to `open-file`. -/
def openBoundTo (text : String) : Config.Registry :=
  ({} : Config.Registry).replaceBindings .compiled #[{ keys := keys text, command := "open-file" }]

/-- The checks of the menu bar (`Editor/Menu.lean`, `Editor/Menu/Compiled.lean`):
a command item chosen runs its command as an invocation, and the key
equivalents the published menu shows are the chords the registry binds. -/
def menuChecks : List Check :=
  [{  name :=
        "a menu's undo undoes as u does: after x over abc, both leave abc and the same selection"
      run :=
        pure <|
          match evilDriver "|abc" with
          | none => false
          | some driver =>
            let cut := evilFed driver "x"
            let byKey := evilFed cut "u"
            let byMenu := (cut.feed { event := .menu "undo", stamp := 0 }).1
            evilShown cut != evilShown byKey && evilShown byMenu == evilShown byKey &&
              (evilShown byKey).replace "|" "" == "abc" &&
              evilSelection byMenu == evilSelection byKey },
    { name :=
        "a menu item naming a command the view's state's run table has an entry for runs that entry, with the report of the state it enters: t-enter in normal state leaves the view in visual-line, its selection of the line shape, at rest; one that gives up leaves the scheme at rest in normal state"
      run :=
        pure <|
          match menuRunDriver "a|b\ncd" with
          | none => false
          | some driver =>
            let initial := menuRunScheme.report menuRunScheme.init ⟨0⟩
            let entered := (driver.feed { event := .menu "t-enter", stamp := 0 }).1
            let failed := (driver.feed { event := .menu "t-fail", stamp := 0 }).1
            let report := menuRunScheme.report entered.loop.input ⟨0⟩
            report.shape == .line && report.selecting &&
              menuRunScheme.report entered.loop.atRest ⟨0⟩ == report &&
              (menuRunSelection entered).map (·.shape) == some .line &&
              entered.loop.state.echo.isEmpty &&
              failed.loop.state.echo == "t-fail: failed" &&
              menuRunScheme.report failed.loop.input ⟨0⟩ == initial &&
              menuRunScheme.report failed.loop.atRest ⟨0⟩ == initial &&
              menuRunSelection failed == menuRunSelection driver },
    { name := "a menu's minimise-window asks the frame to minimise"
      run := pure (framed frameDriver [.menu "minimise-window"] == some (#[.minimise], false)) },
    { name :=
        "a menu runs config's command of its name in place of the compiled one, and a command only config registers"
      run :=
        let replaced :=
          frameRegistry (commands :=
            #[{ name := "minimise-window", action := .plain (Display.askFrame .enterFullscreen) }])
        let greeting :=
          frameRegistry (commands :=
            #[{ name := "greet", action := .plain (Display.askFrame .leaveFullscreen) }])
        pure
          (framed (frameDriver replaced) [.menu "minimise-window"] ==
              some (#[.enterFullscreen], false) &&
            framed (frameDriver greeting) [.menu "greet"] == some (#[.leaveFullscreen], false)) },
    { name :=
        "a menu naming no command says no such command as an invocation does, and asks the frame nothing"
      run :=
        pure <|
          match frameDriver with
          | none => false
          | some driver =>
            let fed := (fedTo driver [.menu "nope"]).1
            fed.loop.state.echo == "nope: no such command" && fed.model.display.asked.isEmpty },
    { name :=
        "a menu, a file to open and the system's quit publish with the padding and the mode line the step's keys carry: views padded 8 across and 8 down, the echo 8, and the status lines the handed segments', whether the command runs to its end or is refused"
      run :=
        let ran : Call → EditorM (Option Config.Write) := fun _ => pure none
        let refused : Call → EditorM (Option Config.Write) := fun _ => throw .badRange
        let handed : Loop.Keys TestScheme.scheme :=
          { padding := 8
            modeLine := { left := #[ModeLine.position], right := #[ModeLine.buffer] }
            command? := fun
              | "noop" => some ran
              | "balk" => some refused
              | name => if name == Files.openName || name == Ex.quitName then some ran else none }
        let status : Array StatusField :=
          #[{ text := "All", face := ModeLine.secondaryFace, padding := 4 },
            { text := "scratch", face := ModeLine.bufferFace, side := .right, padding := 4 }]
        let publishedBy (event : Event) : Bool :=
          match dispatched handed [event] with
          | some (_, #[scene], _) =>
            scene.views.map (·.padding) == #[{ across := 8, down := 8 }] &&
              scene.echoPadding == 8 &&
              scene.views.map (·.status) == #[status]
          | _ => false
        pure
          ([Event.menu "noop", .menu "balk", .openFiles ["a"], .quitRequested].all publishedBy) },
    { name :=
        "on the compiled registry the published menu is the standard one with the chords bound to its commands: s-o, s-s, s-z, s-Z, s-x, s-c, s-v, s-a, s-m and C-s-f, and the system items' own"
      run :=
        pure
          (menuShown frameRegistry == some (Menu.standard.withKeys compiledEquivalents) &&
            ["open-file", "save-buffer", "undo", "redo", "clipboard-cut", "clipboard-copy",
                  "clipboard-paste", "select-all", "minimise-window", "toggle-fullscreen",
                  "nope"].all
              fun name => frameRegistry.keyEquivalent? name == compiledEquivalents name) },
    { name :=
        "the published default menu's Edit menu is Undo, Redo, a separator, Cut, Copy, Paste, a separator and Select All, with the key equivalents s-z, s-Z (s-S-z), s-x, s-c, s-v and s-a"
      run :=
        let edit : Option Submenu :=
          (menuShown frameRegistry).bind fun menu => menu.menus.find? (·.title == "Edit")
        pure
          (edit.map (·.items) ==
            some
              #[.item "Undo" (equivalent 'z') (.command "undo"),
                .item "Redo" (equivalent 'Z') (.command "redo"), .separator,
                .item "Cut" (equivalent 'x') (.command "clipboard-cut"),
                .item "Copy" (equivalent 'c') (.command "clipboard-copy"),
                .item "Paste" (equivalent 'v') (.command "clipboard-paste"), .separator,
                .item "Select All" (equivalent 'a') (.command "select-all")]) },
    { name := "after config binds toggle-fullscreen to M-s-f, Enter Full Screen shows M-s-f"
      run :=
        let rebound :=
          frameRegistry #[{ keys := keys "M-s-f", command := FrameCommands.toggleFullscreenName }]
        let shown := equivalent 'f' { alt := true, superKey := true }
        pure
          (rebound.keyEquivalent? "toggle-fullscreen" == shown &&
            ((menuShown rebound).bind (keyShown · "toggle-fullscreen")) == some shown) },
    { name :=
        "an item whose command has no single chord with the system key shows none: s-o rebound by config to another command, only C-x C-f, only C-o"
      run :=
        let taken := frameRegistry #[{ keys := keys "s-o", command := "save-buffer" }]
        let registries := [taken, openBoundTo "C-x C-f", openBoundTo "C-o"]
        pure <|
          registries.all fun registry =>
            registry.keyEquivalent? "open-file" == none &&
              ((menuShown registry).bind (keyShown · "open-file")) == some none },
    { name :=
        "a chord a system item shows is no command item's, as AppKit runs the system item: config's s-q, s-h or M-s-h alone to save-buffer shows none on Save, and beside the compiled s-s Save shows s-s"
      run :=
        let bound := fun text =>
          ({} : Config.Registry).replaceBindings .config
            #[{ keys := keys text, command := Files.saveName }]
        let beside := frameRegistry #[{ keys := keys "s-q", command := Files.saveName }]
        pure
          (["s-q", "s-h", "M-s-h"].all
              (fun text =>
                ((menuShown (bound text)).bind (keyShown · Files.saveName)) == some none) &&
            ((menuShown beside).bind (keyShown · Files.saveName)) == some (equivalent 's') &&
            (menuShown beside).map (·.systemKeys) == some Menu.standard.systemKeys) }]

/-- The registry of the clipboard command checks: the menu bar's compiled
bindings, for the owner `compiled`, and `config` as config's bindings. -/
def clipRegistry (config : Array Config.KeyBinding := #[]) : Config.Registry :=
  (({} : Config.Registry).replaceBindings .compiled Menu.bindings).replaceBindings .config config

/-- What a step of the clipboard command checks is handed: evil's commands
and the minibuffer's, then `commands`, with the active keymaps and the menu
bar `clipRegistry config` makes, as a host's are. -/
def clipHanded (config : Array Config.KeyBinding := #[])
    (commands : List (String × Dispatched) := []) : Loop.Keys Vim.Default.scheme :=
  let registry := clipRegistry config
  { evilHanded Minibuffer.commands
      commands with
    maps := registry.activeMaps Vim.Default.scheme
    menu := some (registry.menuOf Menu.standard) }

/-- A driver of the clipboard command checks over the text and cursor
`fixture` says, with the unnamed register holding `evilSentinel`, on the
editor's models with the clipboard model `clipboard`, each step handed
`handed`. -/
def clipDriver (fixture : String) (clipboard : ClipboardModel := {})
    (handed : Loop.Keys Vim.Default.scheme := clipHanded) : Option EvilDriver :=
  let (contents, head) := barred fixture
  (Loop.Driver.over handed (fun _ => none)
      (do
        return (← evilState contents head).setRegister Evil.unnamed evilSentinel)
      { editorModel with clipboard }).toOption

/-- `driver` once the command `name` was chosen: by pressing the key string
`chord` when `byKey`, and from its menu item otherwise. -/
def clipRan (byKey : Bool) (name chord : String) (driver : EvilDriver) : EvilDriver :=
  if byKey then evilFed driver chord else (driver.feed { event := .menu name, stamp := 0 }).1

/-- What the scheme reports of the focused view of `driver`. -/
def clipReport (driver : EvilDriver) : InputScheme.Report :=
  Vim.Default.scheme.report driver.loop.input driver.loop.state.frame.focused

/-- The keys `typed` pressed from the text and cursor `fixture` says, on the
clipboard model `clipboard`, and then the command `name` chosen by `chord`
when `byKey` and by its menu item otherwise: what they left, the text the
clipboard model then holds, and the scheme's report of the focused
view. -/
def clipLeft (byKey : Bool) (name chord fixture typed : String) (clipboard : ClipboardModel) :
    Option (EvilEdited × Option String × InputScheme.Report) :=
  (clipDriver fixture clipboard).map fun driver =>
    let after := clipRan byKey name chord (evilFed driver typed)
    (evilLeft after, after.model.clipboard.held, clipReport after)

/-- A prompt opened over `a|b` and `A` typed in it, on the clipboard model
`clipboard`, and then the command `name` chosen by `chord` when `byKey` and
by its menu item otherwise: what the minibuffer's view shows, what the asking
view shows, what the echo area says, the text the clipboard model holds,
and whether the prompt is still open. -/
def clipInPrompt (byKey : Bool) (name chord : String) (clipboard : ClipboardModel := {}) :
    Option (String × String × String × Option String × Bool) :=
  let ask : Dispatched := fun _ => do
    discard <| prompt "Name: " { command := "greet" }
    return none
  (clipDriver "a|b" clipboard (clipHanded (commands := [("ask", ask)]))).map fun driver =>
    let (asking, _) := driver.stepped (driver.loop.runNamed driver.handed "ask")
    let after := clipRan byKey name chord (evilFed asking "A")
    (evilShown after ⟨1⟩, evilShown after, after.loop.state.echo, after.model.clipboard.held,
      after.loop.state.prompt.isSome)

/-- Whether `holds` of a command chosen by its chord and of one chosen by
its menu item. -/
def bothWays (holds : Bool → Bool) : Bool :=
  holds true && holds false

/-- What a command that gave up with `reason` says in the echo area, after
its name. -/
def gaveUpSaying (name reason : String) : String :=
  s!"{name}: {reason}"

/-- The checks of the Edit menu's clipboard commands
(`Editor/Evil/Clipboard.lean`): Cut, Copy, Paste and Select All, each by
its chord and by its menu item, in each Vim state, on the loop's driver over
the editor's models with the registry's active keymaps and the clipboard
model. -/
def clipboardCommandChecks : List Check :=
  [{  name :=
        "Copy in visual over part of a line leaves that text in the clipboard model and the view in normal state; in visual-line it leaves the lines, line-wise; in normal state it gives up with nothingSelected in the echo area and the clipboard model holds what it held"
      run :=
        pure <|
          !Evil.nothingSelected.isEmpty &&
            bothWays fun byKey =>
              let copy := clipLeft byKey Evil.copyName "s-c"
              let normal := vimDefaultReport ""
              copy "foo |bar baz" "v l l" { held := some "before" } ==
                  some (⟨"foo |bar baz", charwise "bar", false, ""⟩, some "bar", normal) &&
                copy "ab\nc|d\nef" "V" { held := some "before" } ==
                  some (⟨"ab\n|cd\nef", linewise "cd\n", false, ""⟩, some "cd\n", normal) &&
                copy "foo |bar" "" { held := some "before" } ==
                  some
                    (⟨"foo |bar", asItWas, false, gaveUpSaying Evil.copyName Evil.nothingSelected⟩,
                      some "before", normal) },
    { name :=
        "Cut in visual and visual-line removes the selection, leaves it in the clipboard model, and one u gives back the text; it is one step of the history; in normal state it gives up with nothingSelected and the buffer and the clipboard model are as they were; with a clipboard not available it deletes, keeps the text in the unnamed register and says so"
      run :=
        pure <|
          bothWays fun byKey =>
            let cut := clipLeft byKey Evil.cutName "s-x"
            let normal := vimDefaultReport ""
            let undone (fixture typed : String) : Option (Option (Nat × Bool) × Option String) :=
              (clipDriver fixture).map fun driver =>
                let ran := clipRan byKey Evil.cutName "s-x" (evilFed driver typed)
                (evilHistory ran, evilText (evilFed ran "u"))
            cut "foo |bar baz" "v l l" { held := some "before" } ==
                some (⟨"foo | baz", charwise "bar", false, ""⟩, some "bar", normal) &&
              cut "ab\nc|d\nef" "V" { held := some "before" } ==
                some (⟨"ab\n|ef", linewise "cd\n", false, ""⟩, some "cd\n", normal) &&
              undone "foo |bar baz" "v l l" == some (some (2, false), some "foo bar baz") &&
              undone "ab\nc|d\nef" "V" == some (some (2, false), some "ab\ncd\nef") &&
              cut "foo |bar" "" { held := some "before" } ==
                some
                  (⟨"foo |bar", asItWas, false, gaveUpSaying Evil.cutName Evil.nothingSelected⟩,
                    some "before", normal) &&
              cut "foo |bar baz" "v l l" { available := false } ==
                some
                  (⟨"foo | baz", charwise "bar", false, Evil.clipboardUnavailable⟩, none, normal) },
    { name :=
        "Cut in visual replaces the last change, as \" + d does: after an x, a . after it leaves what a . after \" + d leaves (a change over a selection, not repeated), not a second x; a . after a Copy repeats the x, as a . after \" + y does"
      run :=
        pure <|
          bothWays fun byKey =>
            let repeated (chord name : String) : Option (EvilEdited × Option String) :=
              (clipDriver "foo |bar bar bar").map fun driver =>
                let after := evilFed (clipRan byKey name chord (evilFed driver "x v l l")) "."
                (evilLeft after, after.model.clipboard.held)
            let cut := repeated "s-x" Evil.cutName
            let copied := repeated "s-c" Evil.copyName
            cut.isSome && cut == evilClipped "foo |bar bar bar" "x v l l \" + d ." &&
              (cut.map fun left =>
                  (left.1.shown, left.1.echo.endsWith (Evil.notRepeated Evil.overSelection))) ==
                some ("foo |bar bar", true) &&
              copied.isSome &&
              copied == evilClipped "foo |bar bar bar" "x v l l \" + y ." &&
              (copied.map (·.1.shown)) == some "foo |r bar bar" },
    { name :=
        "Paste called with a report that is not exclusive, in no state whose run table has an entry for it, puts the clipboard's text before the cursor, as \" + P does, and leaves the clipboard model as it was"
      run :=
        pure <|
          let pasting : Dispatched := fun call => do
            Evil.paste { call with report := { call.report with shape := .inclusive } }
            return none
          let pasted (fixture : String) (held : String) : Option (EvilEdited × Option String) :=
            (clipDriver fixture { held := some held }
                  (clipHanded (commands := [("t-paste", pasting)]))).map
              fun driver =>
              let (after, _) := driver.stepped (driver.loop.runNamed driver.handed "t-paste")
              (evilLeft after, after.model.clipboard.held)
          pasted "a|b" "XY" == evilClipped "a|b" "\" + P" { held := some "XY" } &&
            (pasted "a|b" "XY").map (fun left => (left.1.shown, left.2)) ==
              some ("aX|Yb", some "XY") &&
            (pasted "a|b\n" "cd\n").map (fun left => (left.1.shown, left.2)) ==
              some ("|cd\nab\n", some "cd\n") },
    { name :=
        "Paste puts the clipboard's text before the cursor in normal state (as \" + P), in place of the selection in visual and visual-line, and at the bar as typed text in insert state and in the minibuffer"
      run :=
        pure <|
          bothWays fun byKey =>
            let paste := clipLeft byKey Evil.pasteName "s-v"
            let held : ClipboardModel := { held := some "XY" }
            (paste "a|b" "" held).map (·.1) == (evilClipped "a|b" "\" + P" held).map (·.1) &&
              (paste "a|b" "" held).map (·.1.shown) == some "aX|Yb" &&
              (paste "a|bcd" "v l" held).map (·.1.shown) == some "aX|Yd" &&
              (paste "ab\nc|d\nef" "V" held).map (·.1.shown) == some "ab\n|XY\nef" &&
              paste "a|b" "i" held ==
                some (⟨"aXY|b", asItWas, true, ""⟩, some "XY", vimDefaultReport "i") &&
              clipInPrompt byKey Evil.pasteName "s-v" held ==
                some ("AXY|", "a|b", "", some "XY", true) },
    { name :=
        "after a Paste in each of normal, visual, visual-line, insert and minibuffer the clipboard model holds what it held before, and in the visual states the replaced text is in the unnamed register and not the clipboard, and the view is in normal state"
      run :=
        pure <|
          bothWays fun byKey =>
            let paste := clipLeft byKey Evil.pasteName "s-v"
            let held : ClipboardModel := { held := some "XY" }
            let normal := vimDefaultReport ""
            (paste "a|b" "" held).map (fun left => (left.1.register, left.2)) ==
                some (asItWas, (some "XY", normal)) &&
              (paste "a|bcd" "v l" held).map (fun left => (left.1.register, left.2)) ==
                some (charwise "bc", (some "XY", normal)) &&
              (paste "ab\nc|d\nef" "V" held).map (fun left => (left.1.register, left.2)) ==
                some (linewise "cd\n", (some "XY", normal)) &&
              (paste "a|b" "i" held).map (·.2.1) == some (some "XY") &&
              (clipInPrompt byKey Evil.pasteName "s-v" held).map (·.2.2.2.1) == some (some "XY") },
    { name :=
        "Paste with a clipboard model holding no text gives up with nothingToPut, and with one not available with clipboardUnavailable, in normal, a visual state and insert state, and leaves the buffer as it was"
      run :=
        pure <|
          bothWays fun byKey =>
            let refused (fixture typed shown : String) (clipboard : ClipboardModel)
              (reason : String) : Bool :=
              match clipLeft byKey Evil.pasteName "s-v" fixture typed clipboard with
              | some (left, _, _) =>
                left.shown == shown && left.register == none && left.echo.endsWith reason &&
                  (left.echo.splitOn "refused").length == 1
              | none => false
            [("a|b", "", "a|b"), ("a|bcd", "v l", "ab|cd"), ("a|b", "i", "a|b")].all
              fun (fixture, typed, shown) =>
              refused fixture typed shown {} Evil.nothingToPut &&
                refused fixture typed shown { available := false } Evil.clipboardUnavailable },
    { name :=
        "Select All from normal and from insert state leaves the view in visual-line with one range from offset 0 to the first non-blank of the last line, the cursor on the last line; from visual too"
      run :=
        pure <|
          bothWays fun byKey =>
            let all (fixture typed : String) :
              Option (Option Selection × InputScheme.Report × String) :=
              (clipDriver fixture).map fun driver =>
                let after := clipRan byKey Evil.selectAllName "s-a" (evilFed driver typed)
                (evilSelection after, clipReport after, after.loop.state.echo)
            let lines (anchor head : Nat) :
              Option (Option Selection × InputScheme.Report × String) :=
              some (some { ranges := #[⟨anchor, head⟩], shape := .line }, vimDefaultReport "V", "")
            all "a|b\ncd\n  ef" "" == lines 0 8 && all "a|b\ncd\n  ef" "i" == lines 0 8 &&
              all "ab\nc|d\n" "" == lines 0 3 &&
              all "a|b\ncd" "v" == lines 0 3 &&
              all "a|b\ncd" "V" == lines 0 3 },
    { name :=
        "s-x, s-c, s-v and s-a run the four commands in normal, insert, visual, visual-line and the minibuffer (each leaves what that command leaves there, or its refusal names it), and config's binding of s-c to another command runs that command instead, with the clipboard model as it was"
      run :=
        pure <|
          let greet : Dispatched := fun _ => do
            message "hello"
            return none
          let rebound := clipHanded #[{ keys := keys "s-c", command := "greet" }] [("greet", greet)]
          let overridden :=
            (clipDriver "foo |bar baz" { held := some "before" } rebound).map fun driver =>
              let after := evilFed driver "v l l s-c"
              (evilLeft after, after.model.clipboard.held, clipReport after)
          overridden ==
              some
                (⟨"foo ba|r baz", asItWas, false, "hello"⟩, some "before", vimDefaultReport "v") &&
            bothWays fun byKey =>
              let insertRefused (name chord reason : String) : Bool :=
                (clipLeft byKey name chord "a|b" "i" { held := some "before" }).map
                    (fun left => (left.1.shown, left.1.echo, left.2.1)) ==
                  some ("a|b", gaveUpSaying name reason, some "before")
              insertRefused Evil.copyName "s-c" Evil.nothingSelected &&
                insertRefused Evil.cutName "s-x" Evil.nothingSelected &&
                clipInPrompt byKey Evil.copyName "s-c" { held := some "before" } ==
                  some
                    ("A|", "a|b", gaveUpSaying Evil.copyName Evil.nothingSelected, some "before",
                      true) &&
                clipInPrompt byKey Evil.cutName "s-x" { held := some "before" } ==
                  some
                    ("A|", "a|b", gaveUpSaying Evil.cutName Evil.nothingSelected, some "before",
                      true) &&
                clipInPrompt byKey Evil.selectAllName "s-a" ==
                  some
                    ("A|", "a|b", gaveUpSaying Evil.selectAllName Evil.noLineSelection, none,
                      true) &&
                (clipLeft byKey Evil.copyName "s-c" "a|b\ncd" "V j" {}).map (·.2.1) ==
                  some (some "ab\ncd\n") },
    { name :=
        "a Cut or Copy refused (nothing selected) or stopped by the interrupt before any one of its requests leaves the clipboard model as it was, and a refused or stopped Cut leaves the buffer as it was"
      run :=
        pure <|
          let swept (byKey : Bool) (name chord : String) (whole : EvilEdited × Option String) :
            Bool :=
            match clipDriver "foo |bar baz" { held := some "before" } with
            | none => false
            | some driver =>
              let selected := evilFed driver "v l l"
              let ran (asks : Option Nat) : EvilEdited × Option String :=
                let after :=
                  clipRan byKey name chord
                    { selected with
                      model :=
                        { selected.model with
                          watch := { selected.model.watch with arrivesAfter := asks } } }
                (evilLeft after, after.model.clipboard.held)
              let stopped : EvilEdited × Option String :=
                (⟨"foo ba|r baz", asItWas, false, s!"{Vim.operateCommand}: interrupted"⟩,
                  some "before")
              let runs := (List.range 80).map fun asks => ran (some asks)
              ran none == whole && runs.all (fun run => run == stopped || run == whole) &&
                (runs.filter (· == stopped)).length > 4 &&
                runs.getLast? == some whole
          swept true Evil.cutName "s-x" (⟨"foo | baz", charwise "bar", false, ""⟩, some "bar") &&
            swept false Evil.copyName "s-c"
              (⟨"foo |bar baz", charwise "bar", false, ""⟩, some "bar") &&
            bothWays fun byKey =>
              [(Evil.cutName, "s-x"), (Evil.copyName, "s-c")].all fun (name, chord) =>
                (clipLeft byKey name chord "foo |bar" "" { held := some "before" }).map
                    (fun left => (left.1.shown, left.2.1)) ==
                  some ("foo |bar", some "before") }]

/-- What the watch model answers a start of `target` coalesced as
`coalescing`, made at `now`. -/
def watchStart (model : FileWatchModel) (target : FileWatch.Target)
    (coalescing : FileWatch.Coalescing) (now : Nat := 0) :
    Except FileWatchError FileWatch.Id × FileWatchModel × Nat :=
  model.handle now none (.start target coalescing)

/-- What the watch model answers a `next` of `watch` made at `now` by a job
cancelled at `cancelAt`. -/
def watchNext (model : FileWatchModel) (watch : Nat) (now : Nat := 0)
    (cancelAt : Option Nat := none) :
    Except FileWatchError (Array FileWatch.Change) × FileWatchModel × Nat :=
  model.handle now cancelAt (.next ⟨watch⟩)

/-- The change of `path` with `kinds`. -/
def changeOf (path : System.FilePath) (kinds : List FileWatch.Kind) : FileWatch.Change :=
  { path, kinds := kinds.foldl FileWatch.Kinds.add {} }

/-- A model with `watchRoot` and its subdirectory `sub` there. -/
def watchModel : FileWatchModel :=
  { directories := #[watchRoot, watchRoot / "sub"] }

/-- No window, and room for every check's paths. -/
def atOnce : FileWatch.Coalescing :=
  { window := 0, bound := 100 }

/-- The checks of the watch model (`Editor/FileWatch/Model.lean`), exactly:
the kinds of a change as an exact set, the window moving the clock, the
bound, the routing of each kind of target, the order of the refusals, and a
watch ended with its job. -/
def fileWatchModelChecks : List Check :=
  [{  name :=
        "the watch model delivers one change a path with exactly the kinds recorded there, in the order of each path's first change"
      run := do
        let (_, model, _) := watchStart watchModel (.directory watchRoot false) atOnce
        let model :=
          model.touch
            #[(watchRoot / "b", .written), (watchRoot / "a", .created), (watchRoot / "b", .removed),
              (watchRoot / "a", .written)]
            0
        let (reply, _, _) := watchNext model 1
        return reply ==
            .ok
              #[changeOf (watchRoot / "b") [.written, .removed],
                changeOf (watchRoot / "a") [.created, .written]] },
    { name :=
        "the watch model answers a next at the window from the first change, moving the clock there, or now if that is later"
      run := do
        let window : FileWatch.Coalescing := { window := 300, bound := 10 }
        let (_, model, _) := watchStart watchModel (.file (watchRoot / "f")) window
        let model :=
          (model.touch #[(watchRoot / "f", .written)] 100).touch #[(watchRoot / "f", .written)] 350
        let (early, _, earlyNow) := watchNext model 1 150
        let (late, _, lateNow) := watchNext model 1 500
        let written := Except.ok #[changeOf (watchRoot / "f") [.written]]
        return early == written && earlyNow == 400 && late == written && lateNow == 500 },
    { name :=
        "the watch model collapses a delivery past its bound to missed of the watch's own path, keeps it collapsed until it is taken, then records anew"
      run := do
        let bound : FileWatch.Coalescing := { window := 0, bound := 2 }
        let (_, model, _) := watchStart watchModel (.directory watchRoot false) bound
        let model :=
          model.touch
            #[(watchRoot / "a", .written), (watchRoot / "b", .written), (watchRoot / "c", .written),
              (watchRoot / "a", .removed)]
            0
        let (collapsed, model, _) := watchNext model 1
        let (after, _, _) := watchNext (model.touch #[(watchRoot / "d", .created)] 0) 1
        return collapsed == .ok #[changeOf watchRoot [.missed]] &&
            after == .ok #[changeOf (watchRoot / "d") [.created]] },
    { name :=
        "the watch model's file watch keeps its file and drops its siblings; an entries watch keeps what is directly inside, and a recursive one what is deeper too"
      run := do
        let (_, model, _) := watchStart watchModel (.file (watchRoot / "f")) atOnce
        let (_, model, _) := watchStart model (.directory watchRoot false) atOnce
        let (_, model, _) := watchStart model (.directory watchRoot true) atOnce
        let model :=
          model.touch
            #[(watchRoot / "g", .written), (watchRoot / "sub" / "x", .written),
              (watchRoot / "f", .written), ("/elsewhere/f", .written)]
            0
        let (file, model, _) := watchNext model 1
        let (entries, model, _) := watchNext model 2
        let (tree, _, _) := watchNext model 3
        return file == .ok #[changeOf (watchRoot / "f") [.written]] &&
            entries ==
              .ok #[changeOf (watchRoot / "g") [.written], changeOf (watchRoot / "f") [.written]] &&
            tree ==
              .ok
                #[changeOf (watchRoot / "g") [.written],
                  changeOf (watchRoot / "sub" / "x") [.written],
                  changeOf (watchRoot / "f") [.written]] },
    { name :=
        "the watch model refuses a relative path or a parent component as not absolute, then a bound of 0 as failed, then a missing directory as not found, and starts none of them"
      run := do
        let zero : FileWatch.Coalescing := { window := 0, bound := 0 }
        let isNotAbsolute : Except FileWatchError FileWatch.Id → Bool
          | .error (.notAbsolute _) => true
          | _ => false
        let isFailed : Except FileWatchError FileWatch.Id → Bool
          | .error (.failed _) => true
          | _ => false
        let isNotFound : Except FileWatchError FileWatch.Id → Bool
          | .error (.notFound _) => true
          | _ => false
        let (relative, a, _) := watchStart watchModel (.file "watched/f") zero
        let (parent, b, _) := watchStart watchModel (.directory "/watched/../watched" false) atOnce
        let (bound, c, _) := watchStart watchModel (.file "/nowhere/f") zero
        let (missing, d, _) := watchStart watchModel (.directory "/nowhere" true) atOnce
        let (fileMissing, e, _) := watchStart watchModel (.file "/nowhere/f") atOnce
        -- The library refuses a file with no directory as not found too.
        let (noDirectory, f, _) := watchStart watchModel (.file "/") atOnce
        return isNotAbsolute relative && isNotAbsolute parent && isFailed bound &&
            isNotFound missing &&
            isNotFound fileMissing &&
            isNotFound noDirectory &&
            [a, b, c, d, e, f].all (·.watches.isEmpty) },
    { name :=
        "the watch model's next with nothing recorded fails, or is the cancel at its instant, and a next of a watch it does not have is noSuchWatch"
      run := do
        let (_, model, _) := watchStart watchModel (.file (watchRoot / "f")) atOnce
        let (nothing, _, nothingNow) := watchNext model 1 5
        let (atCancel, _, cancelledNow) := watchNext model 1 5 (some 40)
        let (unknown, _, _) := watchNext model 9
        let isFailed : Except FileWatchError (Array FileWatch.Change) → Bool
          | .error (.failed _) => true
          | _ => false
        return isFailed nothing && nothingNow == 5 && isFailed atCancel && cancelledNow == 40 &&
            unknown == .error .noSuchWatch },
    { name :=
        "in the job model a command a job runs changes what its watch sees, the delivery comes at the window, and the watch ends with its job, finished, failed or cancelled"
      run := do
        let command := JobContract.sh watchRoot "printf x >> f"
        let model : JobModel :=
          { processes :=
              {
                scripts :=
                  #[{ command
                      reply := .ok { exit := .code 0, stdout := .empty, stderr := .empty }
                      takes := 2 }] }
            fileWatches :=
              { watchModel with effects := #[(command, #[(watchRoot / "f", .written)])] } }
        let job (ending : Nat) : JobM Bool := do
          let .ok watch ←
            FileWatch.start (.file (watchRoot / "f")) { window := 10, bound := 4 } | return false
          discard <| Process.run command 100
          let .ok changes ← FileWatch.next watch | return false
          let reached ← now
          match ending with
          | 0 =>
            return changes == #[changeOf (watchRoot / "f") [.written]] && reached == 12
          | 1 =>
            throw "failed"
          | _ =>
            discard <| FileWatch.next watch
            return true
        let (finished, afterFinished) := (job 0).runModel model
        let (failed, afterFailed) := (job 1).runModel model
        let (whenCancelled, afterCancelled) := (job 2).runModel { model with cancelAt := some 50 }
        let endedOne (after : JobModel) :=
          after.fileWatches.ended == #[1] && after.fileWatches.watches.isEmpty
        return finished == .finished true && failed == .failed "failed" &&
            whenCancelled == .cancelled &&
            [afterFinished, afterFailed, afterCancelled].all endedOne }]

/-- A watch model with `watchRoot` there, for the runner's watch checks. -/
def rootWatches : FileWatchModel :=
  { directories := #[watchRoot] }

/-- A job that watches `watchRoot / "f"` and then sleeps for `ms`. -/
def watchesThenSleeps (ms : Nat) : JobM Bool := do
  let .ok _ ← FileWatch.start (.file (watchRoot / "f")) atOnce | return false
  sleep ms
  return true

/-- The checks of the runner's watch waits, on the fake of the watch
service: a watch is named for its job, it ends with its job however the job
ends, a cancelled job's pending read is withdrawn, and removing an owner
ends its jobs' watches. -/
def fileWatchRunnerChecks : List Check :=
  [{  name := "a watch is named for its job: another job's next of it is noSuchWatch, asked of no service"
      run := do
        let (rig, _, watches) ← Rig.withWatches {} rootWatches
        let holder ← rig.spawn (reporting fun _ => watchesThenSleeps 1000)
        unless ← eventually (return (← watches.watching) == 1) do
          return false
        let id := ((← watches.started)[0]?.map (·.1)).getD 0
        let other ←
          rig.spawn
              (reporting fun _ => do
                let .error .noSuchWatch ← FileWatch.next ⟨id.toNat⟩ | return false
                return true)
        let refused ← other.endedAs (.finished #["true"])
        holder.handle.cancel
        let asked :=
          (← watches.started).any fun (_, request) =>
            match request with
            | .next _ => true
            | _ => false
        return refused && !asked },
    { name := "a watch ends with its job, finished, failed or cancelled, through the watch service's cancel"
      run := do
        let (rig, _, watches) ← Rig.withWatches {} rootWatches
        let finished ← rig.spawn (reporting fun _ => watchesThenSleeps 0)
        let failed ←
          rig.spawn
              (reporting fun _ => (do
                discard <| watchesThenSleeps 0
                throw "failed" : JobM Bool))
        let cancelled ← rig.spawn (reporting fun _ => watchesThenSleeps 1000000)
        let ended ←
          (return (← finished.endedAs (.finished #["true"])) && (← failed.endedAs (.failed "failed")))
        unless ← eventually (return (← watches.watching) == 1) do
          return false
        cancelled.handle.cancel
        let cancelledEnded ← cancelled.endedAs .cancelled
        let ids := (← watches.started).map (·.1)
        return ended && cancelledEnded && (← watches.watching) == 0 &&
            (← watches.ended).qsort (· < ·) == (ids.map (·.toNat)).qsort (· < ·) &&
            ids.all (← watches.withdrawn).contains },
    { name := "a cancelled job's pending next is withdrawn from the watch service, and its watch ended"
      run := do
        let (rig, _, watches) ← Rig.withWatches {} rootWatches
        let spawned ←
          rig.spawn
              (reporting fun _ => do
                let .ok watch ← FileWatch.start (.file (watchRoot / "f")) atOnce | return false
                discard <| FileWatch.next watch
                return true)
        unless ← eventually (return (← watches.started).size == 2) do
          return false
        let started ← watches.started
        spawned.handle.cancel
        let ended ← spawned.endedAs .cancelled
        let withdrawn ← watches.withdrawn
        return ended && started.all (withdrawn.contains ·.1) && (← watches.watching) == 0 &&
            (← watches.waiting) == 0 },
    { name := "Jobs.removeOwner ends the watches of the owner's jobs, and leaves another owner's"
      run := do
        let (rig, _, watches) ← Rig.withWatches {} rootWatches
        let sleeps : Work := reporting fun _ => watchesThenSleeps 1000000
        let jobs : Job.Jobs := { services := rig.services }
        let (_, jobs) ← jobs.start anna "watches" sleeps fun _ => pure ()
        let (_, jobs) ← jobs.start ben "watches" sleeps fun _ => pure ()
        unless ← eventually (return (← watches.watching) == 2) do
          return false
        let (_, jobs) ← jobs.removeOwner anna
        let annasEnded ← eventually (return (← watches.watching) == 1)
        let one := (← watches.ended).size == 1
        jobs.cancelAll
        let allEnded ← eventually (return (← watches.watching) == 0)
        return annasEnded && one && allEnded }]

/-! ## A child's environment, looked up for its directory -/

/-- What `mise env --json` prints, in its layout: one name a line, indented
two spaces, with a `PATH` of 400 characters. -/
def miseOutput : String :=
  let path := String.ofList (List.replicate 400 'p')
  "{\n  \"PATH\": \"" ++ path ++
    "\",\n  \"MACOSX_DEPLOYMENT_TARGET\": \"27.2\",\n  \"RUST\": \"1.98\"\n}\n"

/-- Whether `parseVariables` reads `bytes` as `expected`. -/
def readsVariables (bytes : ByteArray) (expected : Array (String × String)) : Bool :=
  match Process.parseVariables bytes with
  | .ok variables => variables == expected
  | .error _ => false

/-- Whether `parseVariables` refuses `text` with `why`. -/
def refusesVariables (text : String) (why : String) : Bool :=
  match Process.parseVariables text.toUTF8 with
  | .error said => said == why
  | .ok _ => false

/-- An entry of a lookup that failed with `failure`, its config files' stamps
`stamps`. -/
def failedEntry (failure : Process.Failure) (stamps : Array (Option File.Stamp) := #[]) :
    Process.Entry :=
  { stamps, found := .failed failure }

/-- The checks of the pure part of a child's environment
(`Editor/Process/Environment.lean`): the parser of what mise prints, how the
lookup's variables and a command's own environment combine, the config files
whose stamps keep an entry, the shared state's answers and the messages. -/
def processEnvironmentChecks : List Check :=
  [{  name :=
        "parseVariables reads mise's layout, a multi-line object with a PATH of 400 characters"
      run :=
        pure
          (readsVariables miseOutput.toUTF8
            #[("PATH", String.ofList (List.replicate 400 'p')),
              ("MACOSX_DEPLOYMENT_TARGET", "27.2"), ("RUST", "1.98")]) },
    { name :=
        "parseVariables reads every escape, a surrogate pair among them, and the empty object; the last of a name that comes twice wins"
      run :=
        pure
          (readsVariables
              "{\"A\":\"\\\" \\\\ \\/ \\b \\f \\n \\r \\t \\u00e9 \\ud83d\\ude00\",\"B\":\"1\",\"B\":\"2\"}".toUTF8
              #[("A", "\" \\ / \x08 \x0c \n \r \t é 😀"), ("B", "2")] &&
            readsVariables " { } ".toUTF8 #[]) },
    { name :=
        "parseVariables refuses a number, null, a nested object, an array, trailing text, bytes that are not UTF-8, a name holding =, an empty name and a NUL, each with its reason"
      run :=
        pure
          (refusesVariables "{\"A\":1}" "a value is not a string" &&
            refusesVariables "{\"A\":null}" "a value is not a string" &&
            refusesVariables "{\"A\":{}}" "a value is not a string" &&
            refusesVariables "[\"A\"]" "it is not an object" &&
            refusesVariables "{\"A\":\"a\"} x" "there is more after the object" &&
            (match Process.parseVariables ⟨#[0x7B, 0xFF, 0x7D]⟩ with
            | .error why => why == "it is not UTF-8"
            | .ok _ => false) &&
            refusesVariables "{\"A=B\":\"a\"}" "the name A=B holds =" &&
            refusesVariables "{\"\":\"a\"}" "a name is empty" &&
            refusesVariables "{\"A\":\"a\\u0000\"}" "a string holds a NUL" &&
            refusesVariables "{\"A\":\"a\nb\"}" "a string holds a control character" &&
            refusesVariables "{\"A\":\"\\ud83d\"}"
              "a high surrogate is not followed by a low one") },
    { name :=
        "a lookup's variables are set over the editor's, the command's own set wins over one of the same name, its unset removes one, and clear drops them all"
      run :=
        let variables := #[("PATH", "/m/bin"), ("A", "mise"), ("DROP", "x")]
        pure
          (Process.Environment.over variables {} == { set := variables } &&
            Process.Environment.over variables { set := #[("A", "own")], unset := #["DROP"] } ==
              { set := #[("PATH", "/m/bin"), ("A", "own")], unset := #["DROP"] } &&
            Process.Environment.over variables { clear := true, set := #[("ONLY", "x")] } ==
              { clear := true, set := #[("ONLY", "x")] }) },
    { name := "configPaths of /p/d is mise's four config names in /p/d, then in /p, then in /"
      run :=
        let four (directory : String) : Array System.FilePath :=
          #[s!"{directory}mise.toml", s!"{directory}.mise.toml", s!"{directory}.tool-versions",
                s!"{directory}mise.local.toml"].map
            System.FilePath.mk
        pure
          (Process.configPaths "/p/d" == four "/p/d/" ++ four "/p/" ++ four "/" &&
            Process.configPaths "/p/d/" == Process.configPaths "/p/d") },
    { name :=
        "the shared state gives back the entry a record kept; a failure recorded says its message once, the same failure again says nothing, and with new stamps it says it again"
      run :=
        let state : Process.Environments := {}
        let failure := Process.Failure.exited 1 "untrusted"
        let first := failedEntry failure #[none]
        let message := Process.failureMessage "/p/d" failure
        let ((), state, said) := state.handle (.record "/p/d" first)
        let (cached, state, quiet) := state.handle (.cached "/p/d")
        let cached : Option Process.Entry := cached
        let ((), state, again) := state.handle (.record "/p/d" first)
        let ((), _, renewed) :=
          state.handle (.record "/p/d" (failedEntry failure #[some ⟨1, 0, 3⟩]))
        let variables : Process.Entry := { stamps := #[], found := .variables #[("A", "a")] }
        let ((), _, found) := ({} : Process.Environments).handle (.record "/p/e" variables)
        pure
          (said == some message && cached == some first && quiet.isNone && again.isNone &&
            renewed == some message &&
            found.isNone) },
    { name := "install drops what was resolved and every entry, and keeps the mode and the limit"
      run :=
        let state : Process.Environments :=
          { host := .window (some "/u"), limit := 7, resolved := some (.mise "/m")
            entries := #[("/p", failedEntry (.signalled 9))] }
        let ((), after, said) := state.handle (.install .inherited)
        pure
          (after ==
              { setting := .inherited, host := .window (some "/u"), limit := 7, resolved := none
                entries := #[] } &&
            said.isNone) },
    { name := "the policy is the setting, the mode, what was resolved and the limit"
      run :=
        let state : Process.Environments := { setting := .mise none, resolved := some .inherited }
        let (policy, after, said) := state.handle .policy
        let policy : Process.Policy := policy
        pure
          (policy ==
              { setting := .mise none, host := .headless, resolved := some .inherited
                limit := 5000 } &&
            after == state &&
            said.isNone) },
    { name := "each failure's message has its own words"
      run :=
        let say := Process.failureMessage "/p/d"
        let tail := "; its children get the editor's environment"
        pure
          (say (.exited 1 "not trusted") ==
              "environment: /p/d: mise exited with status 1: not trusted" ++ tail &&
            say (.exited 2 "") == "environment: /p/d: mise exited with status 2" ++ tail &&
            say (.signalled 9) == "environment: /p/d: mise was ended by signal 9" ++ tail &&
            say (.unparsable "it is not an object") ==
              "environment: /p/d: mise's output is not a JSON object of strings: it is not an object" ++
                tail &&
            say (.timedOut 5000) ==
              "environment: /p/d: mise did not finish within 5000 ms and was killed" ++ tail &&
            say (.refused (.denied "Permission denied")) ==
              "environment: /p/d: mise could not be run: the system does not allow it: Permission denied" ++
                tail &&
            say (.missing (Process.miseCandidates (some "/u"))) ==
              "environment: /p/d: mise is not at /u/.local/bin/mise, /opt/homebrew/bin/mise or /usr/local/bin/mise" ++
                tail) },
    { name :=
        "what a lookup's run came to: variables for status 0 and an object, and else the failure, with the first line of standard error"
      run :=
        let ran (exit : Process.Exit) (stdout stderr : String) : Except ProcessError Process.Ran :=
          .ok { exit, stdout := stdout.toUTF8, stderr := stderr.toUTF8 }
        pure
          (Process.foundOf (ran (.code 0) "{\"A\":\"a\"}" "") == .variables #[("A", "a")] &&
            Process.foundOf (ran (.code 1) "" "first\nsecond\n") == .failed (.exited 1 "first") &&
            Process.foundOf (ran (.signal 9) "" "") == .failed (.signalled 9) &&
            Process.foundOf (ran (.code 0) "[1]" "") ==
              .failed (.unparsable "it is not an object") &&
            Process.foundOf (.error .noSuchProcess) == .failed (.refused .noSuchProcess) &&
            Process.foundOf (.error (.timedOut 5000)) == .failed (.timedOut 5000)) }]

/-- The requests `job` makes when it runs against the job port's model from
`model`, in order. -/
def requestsOf {α : Type} (job : JobM α) (model : JobModel) : Array JobRequest :=
  go 10000 job.run model #[]
where
  /-- The requests of `program` from `model`, with `fuel` steps at most. -/
  go : Nat → Program jobPort (Except String α) → JobModel → Array JobRequest → Array JobRequest
    | 0, _, _, seen => seen
    | _, .done _, _, seen => seen
    | fuel + 1, .step request next, model, seen =>
      let (reply, after) := JobModel.handle request model
      go fuel (next reply) after (seen.push request)

/-- A run that ends with the status 0 and prints `stdout`. -/
def printed (stdout : String) : Except ProcessError Process.Ran :=
  .ok { exit := .code 0, stdout := stdout.toUTF8, stderr := .empty }

/-- The command the lookup checks start in `/p/d`: a bare `lake`, with a
variable of its own set and one unset. -/
def lakeBuild : Process.Command :=
  { program := "lake", arguments := #["build"]
    environment := { set := #[("A", "own")], unset := #["DROP"] }, directory := "/p/d" }

/-- What the lookup prints for `/p/d`: a `PATH`, a variable the command sets
too, one it unsets, and one of its own. -/
def lookupJson : String :=
  "{\"PATH\":\"/m/bin:/usr/bin\",\"A\":\"mise\",\"DROP\":\"x\",\"B\":\"b\"}"

/-- `command` with the lookup's variables of `lookupJson` set under its own. -/
def mergedOf (command : Process.Command) : Process.Command :=
  { command with
    environment :=
      { set := #[("PATH", "/m/bin:/usr/bin"), ("B", "b"), ("A", "own")], unset := #["DROP"] } }

/-- `command` in `directory`. -/
def movedTo (command : Process.Command) (directory : System.FilePath) : Process.Command :=
  { command with directory }

/-- A file model holding each of `paths`, written in that order. -/
def filesAt (paths : List System.FilePath) : FileModel :=
  paths.foldl (fun model path => model.withFile path "x".toUTF8) {}

/-- `model` with the file at `path` gone. -/
def withoutFile (model : FileModel) (path : System.FilePath) : FileModel :=
  { model with files := model.files.filter (·.path != path) }

/-- Whether `requests` read the stamp of any of `paths`. -/
def stampsAny (requests : Array JobRequest) (paths : List System.FilePath) : Bool :=
  requests.any fun request =>
    match request with
    | .file (.stamp path) => paths.contains path
    | _ => false

/-- The job model the lookup checks start from: the files `files`, the
scripts of `mise` at `executable` printing `lookupJson` in each of
`directories` and of each command merged there, and the environments with
`setting` and `host`. -/
def lookupModel (setting : Process.Setting) (host : Process.Host) (files : FileModel)
    (executable : System.FilePath := "/opt/mise") (directories : List System.FilePath := ["/p/d"])
    (reply : Except ProcessError Process.Ran := printed lookupJson) (takes : Nat := 0) : JobModel :=
  let scripts : Array Process.Script :=
    directories.toArray.flatMap fun directory =>
      #[{ command := Process.lookupCommand executable directory, reply, takes },
        { command := mergedOf (movedTo lakeBuild directory), reply := printed "built" },
        { command := movedTo lakeBuild directory, reply := printed "built inherited" }]
  { files, processes := { scripts }, environments := { setting, host } }

/-- A run of `command` that the model answers. -/
def runsOn (command : Process.Command) : JobM Bool := do
  return (← Process.run command 1000) matches .ok _

/-- Runs `job` on the model, and gives the model after it. -/
def after {α : Type} (job : JobM α) (model : JobModel) : JobModel :=
  (job.runModel model).2

/-- The checks of a child's environment on the models (AC 1 to 5 of
`docs/design/concurrency.md`, "A child's environment, as built"): each runs
jobs with `JobM.runModel` on one `JobModel`, carried from job to job. -/
def environmentLookupChecks : List Check :=
  let candidates := ["/opt/homebrew/bin/mise", "/usr/local/bin/mise"].map System.FilePath.mk
  [{  name :=
        "auto in the window mode runs the first candidate that exists: Homebrew's, with nothing under the home directory, and the home directory's once it is there"
      run :=
        let homebrew :=
          lookupModel .auto (.window (some "/u")) (filesAt candidates) "/opt/homebrew/bin/mise"
        let home :=
          lookupModel .auto (.window (some "/u")) (filesAt ("/u/.local/bin/mise" :: candidates))
            "/u/.local/bin/mise"
        pure
          ((after (runsOn lakeBuild) homebrew).processes.started ==
              #[Process.lookupCommand "/opt/homebrew/bin/mise" "/p/d", mergedOf lakeBuild] &&
            (after (runsOn lakeBuild) home).processes.started ==
              #[Process.lookupCommand "/u/.local/bin/mise" "/p/d", mergedOf lakeBuild]) },
    { name :=
        "auto in the window mode keeps what it resolved until a reload: with Homebrew's mise gone, a start in another directory still runs it and reads no candidate's stamp, and after install the next start resolves again"
      run :=
        let all : List System.FilePath := "/u/.local/bin/mise" :: candidates
        let model :=
          lookupModel .auto (.window (some "/u")) (filesAt candidates) "/opt/homebrew/bin/mise"
            (directories := ["/p/d", "/p/e"])
        let model :=
          { model with
            processes :=
              { model.processes with
                scripts :=
                  model.processes.scripts.push
                    { command := Process.lookupCommand "/usr/local/bin/mise" "/p/d"
                      reply := printed lookupJson } } }
        let inE := movedTo lakeBuild "/p/e"
        let once := after (runsOn lakeBuild) model
        let gone := { once with files := withoutFile once.files "/opt/homebrew/bin/mise" }
        let second := after (runsOn inE) gone
        let installed := { second with environments := second.environments.install .auto }
        let third := after (runsOn lakeBuild) installed
        pure
          (second.processes.started ==
              #[Process.lookupCommand "/opt/homebrew/bin/mise" "/p/d", mergedOf lakeBuild,
                Process.lookupCommand "/opt/homebrew/bin/mise" "/p/e", mergedOf inE] &&
            !stampsAny (requestsOf (runsOn inE) gone) all &&
            stampsAny (requestsOf (runsOn lakeBuild) installed) all &&
            third.processes.started ==
              second.processes.started ++
                #[Process.lookupCommand "/usr/local/bin/mise" "/p/d", mergedOf lakeBuild]) },
    { name :=
        "mise with no path runs the first candidate that exists, in the headless mode and in the window mode"
      run :=
        let headless :=
          lookupModel (.mise none) .headless (filesAt candidates) "/opt/homebrew/bin/mise"
        let window :=
          lookupModel (.mise none) (.window (some "/u"))
            (filesAt ("/u/.local/bin/mise" :: candidates)) "/u/.local/bin/mise"
        pure
          ((after (runsOn lakeBuild) headless).processes.started ==
              #[Process.lookupCommand "/opt/homebrew/bin/mise" "/p/d", mergedOf lakeBuild] &&
            (after (runsOn lakeBuild) window).processes.started ==
              #[Process.lookupCommand "/u/.local/bin/mise" "/p/d", mergedOf lakeBuild] &&
            (after (runsOn lakeBuild) headless).reported.isEmpty) },
    { name :=
        "auto in the window mode with none of the candidates starts the child as it would have"
      run :=
        pure
          ((after (runsOn lakeBuild)
                (lookupModel .auto (.window (some "/u")) {})).processes.started ==
            #[lakeBuild]) },
    { name := "auto in the headless mode starts the child as it would have and reads no stamp"
      run :=
        let model :=
          lookupModel .auto .headless (filesAt ("/u/.local/bin/mise" :: candidates))
            "/opt/homebrew/bin/mise"
        pure
          ((after (runsOn lakeBuild) model).processes.started == #[lakeBuild] &&
            !(requestsOf (runsOn lakeBuild) model).any fun request =>
                request matches .file (.stamp _)) },
    { name :=
        "with mise at a path, a run first runs mise env --json in its directory, then the command with the lookup's variables under its own: the bare name keeps its name and gets the lookup's PATH"
      run :=
        let model := lookupModel (.mise (some "/opt/mise")) .headless {}
        pure
          ((after (runsOn lakeBuild) model).processes.started ==
            #[Process.lookupCommand "/opt/mise" "/p/d", mergedOf lakeBuild]) },
    { name := "with mise at a path, a streaming start gets the lookup's variables the same way"
      run :=
        let model := lookupModel (.mise (some "/opt/mise")) .headless {}
        let model :=
          { model with
            processes :=
              { model.processes with
                streams :=
                  #[{ command := mergedOf lakeBuild, steps := #[.write .out "built\n".toUTF8] }] } }
        let starts : JobM Bool := do
          return (← Process.start lakeBuild { bound := 64 }) matches .ok _
        pure
          ((starts.runModel model).1 == .finished true &&
            (after starts model).processes.started ==
              #[Process.lookupCommand "/opt/mise" "/p/d", mergedOf lakeBuild]) },
    { name :=
        "a second start in the directory runs no lookup; after mise.toml there or a parent's .tool-versions is rewritten, or a config file appears, the next one looks up again"
      run :=
        let model :=
          lookupModel (.mise (some "/opt/mise")) .headless
            (filesAt ["/p/d/mise.toml", "/p/.tool-versions"])
        let lookup := Process.lookupCommand "/opt/mise" "/p/d"
        let once := after (runsOn lakeBuild) model
        let twice := after (runsOn lakeBuild) once
        let rewritten :=
          after (runsOn lakeBuild)
            { twice with files := twice.files.withFile "/p/d/mise.toml" "y".toUTF8 }
        let parent :=
          after (runsOn lakeBuild)
            { rewritten with files := rewritten.files.withFile "/p/.tool-versions" "y".toUTF8 }
        let appeared :=
          after (runsOn lakeBuild)
            { parent with files := parent.files.withFile "/.mise.toml" "y".toUTF8 }
        let merged := mergedOf lakeBuild
        pure
          (once.processes.started == #[lookup, merged] &&
            twice.processes.started == #[lookup, merged, merged] &&
            rewritten.processes.started == #[lookup, merged, merged, lookup, merged] &&
            parent.processes.started == #[lookup, merged, merged, lookup, merged, lookup, merged] &&
            appeared.processes.started ==
              #[lookup, merged, merged, lookup, merged, lookup, merged, lookup, merged]) },
    { name :=
        "a start in another directory runs its own lookup, and a reload's install drops every entry"
      run :=
        let model :=
          lookupModel (.mise (some "/opt/mise")) .headless {} (directories := ["/p/d", "/p/e"])
        let inD := after (runsOn lakeBuild) model
        let inE := after (runsOn (movedTo lakeBuild "/p/e")) inD
        let installed :=
          { inE with environments := inE.environments.install (.mise (some "/opt/mise")) }
        let again := after (runsOn lakeBuild) installed
        pure
          (inE.processes.started ==
              #[Process.lookupCommand "/opt/mise" "/p/d", mergedOf lakeBuild,
                Process.lookupCommand "/opt/mise" "/p/e", mergedOf (movedTo lakeBuild "/p/e")] &&
            again.processes.started ==
              inE.processes.started ++
                #[Process.lookupCommand "/opt/mise" "/p/d", mergedOf lakeBuild]) },
    { name :=
        "a lookup that exits non-zero starts the child inherited and reports once for the directory; a second start looks up nothing and says nothing"
      run :=
        let model :=
          lookupModel (.mise (some "/opt/mise")) .headless {} (reply :=
            .ok { exit := .code 1, stdout := .empty, stderr := "not trusted\n".toUTF8 })
        let once := after (runsOn lakeBuild) model
        let twice := after (runsOn lakeBuild) once
        pure
          (once.processes.started.back? == some lakeBuild &&
            once.reported == #[Process.failureMessage "/p/d" (.exited 1 "not trusted")] &&
            twice.processes.started == once.processes.started.push lakeBuild &&
            twice.reported == once.reported) },
    { name :=
        "a lookup whose output is not a JSON object of strings starts the child inherited and reports once for the directory"
      run :=
        let model := lookupModel (.mise (some "/opt/mise")) .headless {} (reply := printed "[1]")
        let once := after (runsOn lakeBuild) model
        let twice := after (runsOn lakeBuild) once
        pure
          (once.processes.started.back? == some lakeBuild &&
            once.reported == #[Process.failureMessage "/p/d" (.unparsable "it is not an object")] &&
            twice.processes.started == once.processes.started.push lakeBuild &&
            twice.reported == once.reported) },
    { name :=
        "a lookup that outlives the default limit of 5000 ms is killed at its start plus the limit, the child starts inherited, and the directory is reported once"
      run :=
        let model :=
          { lookupModel (.mise (some "/opt/mise")) .headless {} (takes := 6000) with now := 100 }
        let lookup := Process.lookupCommand "/opt/mise" "/p/d"
        let once := after (runsOn lakeBuild) model
        let twice := after (runsOn lakeBuild) once
        pure
          (once.processes.started == #[lookup, lakeBuild] && once.processes.killed == #[lookup] &&
            once.now == 5100 &&
            once.reported == #[Process.failureMessage "/p/d" (.timedOut 5000)] &&
            twice.processes.started == #[lookup, lakeBuild, lakeBuild] &&
            twice.reported == once.reported) },
    { name :=
        "with the inherited setting, a run and a start start their command exactly, read no stamp, and make only the policy request beyond the process request"
      run :=
        let model :=
          lookupModel .inherited (.window (some "/u"))
            (filesAt ("/u/.local/bin/mise" :: candidates))
        let model :=
          { model with
            processes :=
              { model.processes with
                streams := #[{ command := lakeBuild, steps := #[.write .out "built\n".toUTF8] }] } }
        let starts : JobM Bool := do
          return (← Process.start lakeBuild { bound := 64 }) matches .ok _
        pure
          ((after (runsOn lakeBuild) model).processes.started == #[lakeBuild] &&
            (after starts model).processes.started == #[lakeBuild] &&
            (after (runsOn lakeBuild) model).files == model.files &&
            requestsOf (runsOn lakeBuild) model ==
              #[.environment .policy, .process (.run lakeBuild 1000)]) },
    { name :=
        "a command that clears its environment runs no lookup, and a relative directory or program is refused as before, with no lookup"
      run :=
        let model := lookupModel (.mise (some "/opt/mise")) .headless {}
        let cleared := { lakeBuild with environment := { clear := true } }
        let model :=
          { model with
            processes :=
              { model.processes with
                scripts :=
                  model.processes.scripts.push { command := cleared, reply := printed "" } } }
        let relative := movedTo lakeBuild "p/d"
        let program := { lakeBuild with program := "bin/lake" }
        let refused (command : Process.Command) (error : ProcessError) : Bool :=
          match (Process.run command 1000).runModel model with
          | (.finished (.error refusal), after) =>
            refusal == error && after.processes.started.isEmpty
          | _ => false
        pure
          ((after (runsOn cleared) model).processes.started == #[cleared] &&
            refused relative .relativeDirectory &&
            refused program .relativeProgram) },
    { name :=
        "mise with no path and none of the candidates reports mise is not at them once for each directory, and runs no lookup"
      run :=
        let model :=
          lookupModel (.mise none) (.window (some "/u")) {} (directories := ["/p/d", "/p/e"])
        let once := after (runsOn lakeBuild) model
        let twice := after (runsOn lakeBuild) once
        let other := after (runsOn (movedTo lakeBuild "/p/e")) twice
        let missing := Process.Failure.missing (Process.miseCandidates (some "/u"))
        pure
          (other.processes.started == #[lakeBuild, lakeBuild, movedTo lakeBuild "/p/e"] &&
            other.reported ==
              #[Process.failureMessage "/p/d" missing, Process.failureMessage "/p/e" missing]) }]

/-- The checks of projects, workspaces and locations as data
(`Editor/Workspace.lean`): how an `origin` URL is normalised, how a project
is identified and named, how a workspace is labelled, what each location can
do, and a location's round trip through a buffer-local value. -/
def workspaceDataChecks : List Check :=
  let origin := "git@github.com:o/r.git"
  [{  name :=
        "an origin URL normalises to host/path whatever its form: git@github.com:o/r.git, https://github.com/o/r, ssh://git@github.com/o/r.git and https://github.com/o/r.git/ are one, and so are a host in capitals and an ssh port"
      run :=
        pure <|
          [origin, "https://github.com/o/r", "ssh://git@github.com/o/r.git",
                  "https://github.com/o/r.git/", "https://GitHub.com/o/r",
                  "ssh://git@github.com:22/o/r"].map
              Workspace.normaliseRemote ==
            List.replicate 6 "github.com/o/r" },
    { name :=
        "a project is identified by its normalised origin, else by its common git directory, else by its root, and a name config declares wins; it is named by the origin's last component, else by the common directory's parent's, else by the root's"
      run :=
        let byOrigin := Project.of "/x/clone" (some "/x/clone/.git") (some origin) none
        let byCommon := Project.of "/w" (some "/r/.git") none none
        let byRoot := Project.of "/m" none none none
        let declared := Project.of "/r/tools" none none (some "tools")
        let both := Project.of "/r" (some "/r/.git") (some origin) (some "mine")
        pure
          ((byOrigin.identity, byOrigin.name, byOrigin.remote, byOrigin.commonDir) ==
              (Project.Identity.remote "github.com/o/r", "r", some origin,
                some ("/x/clone/.git" : System.FilePath)) &&
            (byCommon.identity, byCommon.name) == (Project.Identity.commonDir "/r/.git", "r") &&
            (byRoot.identity, byRoot.name) == (Project.Identity.root "/m", "m") &&
            (declared.identity, declared.name) == (Project.Identity.declared "tools", "tools") &&
            (both.identity, both.name) == (Project.Identity.declared "mine", "mine")) },
    { name :=
        "a workspace is labelled name@branch, and name@ and its root's last component when it is detached or has no branch"
      run :=
        let project := Project.of "/r" (some "/r/.git") (some origin) none
        let onMain : Workspace :=
          { location := .local "/r", branch := some (.named "main"), project }
        let detached : Workspace := { location := .local "/w", branch := some .detached, project }
        let marked : Workspace :=
          { location := .local "/m", project := Project.of "/m" none none none }
        pure ([onMain, detached, marked].map Workspace.label == ["r@main", "r@w", "m@m"]) },
    { name :=
        "a local location can read files, run commands and watch files; one reachable by a command and one known only by its branch can do none of them"
      run :=
        let all : Location.Capabilities :=
          { readFiles := true, runCommands := true, watchFiles := true }
        let none : Location.Capabilities :=
          { readFiles := false, runCommands := false, watchFiles := false }
        pure
          ((Location.local "/r").can == all &&
            (Location.reachable "kube" "pod/dev" "/src").can == none &&
            (Location.branchOnly origin "agent/x").can == none) },
    { name :=
        "a location crosses as a buffer-local value and back, and a value that is no location reads as none"
      run :=
        let locations : List Location :=
          [.local "/r", .reachable "kube" "pod/dev" "/src", .branchOnly origin "agent/x"]
        pure
          (locations.all (fun location => Location.decode? location.encode == some location) &&
            [Value.null, .str "/r", .record [("local", .nat 1)], .record []].all
              (Location.decode? · == none)) }]

/-- The checks of how the git adapter reads what git prints
(`Editor/Workspace.lean`, "The git adapter's command lines"). -/
def workspaceGitChecks : List Check :=
  let printed (text : String) : ByteArray := text.toUTF8
  [{  name :=
        "rev-parse's three lines are the top level, the common directory and the branch; HEAD is a detached checkout, and a common directory that is not absolute is resolved against the directory asked about"
      run :=
        pure
          (Workspace.Git.parseRevParse "/r/src" (printed "/r\n/r/.git\nmain\n") ==
              some { toplevel := "/r", commonDir := "/r/.git", branch := .named "main" } &&
            Workspace.Git.parseRevParse "/r" (printed "/r\n.git\nHEAD\n") ==
              some { toplevel := "/r", commonDir := "/r/.git", branch := .detached }) },
    { name :=
        "output that is not three lines, a top level that is not absolute and bytes that are not UTF-8 are no answer"
      run :=
        pure
          ([printed "/r\n/r/.git\n", printed "", printed "r\n/r/.git\nmain\n",
                printed "/r\n/r/.git\nmain\nextra\n", ByteArray.mk #[0xff, 0x0a]].all
            (Workspace.Git.parseRevParse "/r" · == none)) },
    { name := "the origin is the first line git prints, and an empty output is no origin"
      run :=
        pure
          (Workspace.Git.parseOrigin (printed "git@github.com:o/r.git\n") ==
              some "git@github.com:o/r.git" &&
            Workspace.Git.parseOrigin (printed "") == none) }]

/-- A store of a number, for the checks of the workspace and project
stores. -/
def countStore : Store Nat :=
  { name := "count", version := 1, initial := 0, encode := .nat
    decode := fun
      | .nat n => some n
      | _ => none }

/-- The checks of the workspaces and projects the editor state keeps
(`EditorState.workspaces`, `Editor/Workspace.lean`, "The table"), through
the state requests that change them (`Editor/State/Request.lean`) and the
editor API (`Editor/Api.lean`, "Workspaces"). -/
def workspaceStateChecks : List Check :=
  let origin := "git@github.com:o/r.git"
  let main :=
    Workspace.Found.ofGit { toplevel := "/r", commonDir := "/r/.git", branch := .named "main" } none
  let worktree :=
    Workspace.Found.ofGit { toplevel := "/w", commonDir := "/r/.git", branch := .named "feature" }
      none
  let request (state : EditorState) (request : StateRequest) : EditorState :=
    (state.handle request).2
  let recorded : EditorState :=
    request (request EditorState.none (.recordWorkspace "/r/src" 0 (some main)))
      (.recordWorkspace "/w/src" 0 (some worktree))
  let one : BufferId := ⟨1⟩
  [{  name :=
        "a workspace registered with a location known only by its branch and one reachable through kube belong to the project of their remote, whichever form it is in, and neither can run commands or read files; registering a local location is refused, with the state as it was"
      run :=
        let branchOnly := Location.branchOnly origin "agent/x"
        let reachable := Location.reachable "kube" "pod/dev" "/src"
        let (first, state) :=
          EditorState.none.handle (.registerWorkspace branchOnly origin (some "agent/x"))
        let (second, state) :=
          state.handle (.registerWorkspace reachable "https://github.com/o/r" none)
        let (refused, after) := state.handle (.registerWorkspace (.local "/r") origin none)
        let table := state.workspaces
        pure
          (replied first == .inr () && replied second == .inr () &&
            [branchOnly, reachable].all
              (fun location =>
                ((table.workspace? location).map (·.project.identity)) ==
                    some (.remote "github.com/o/r") &&
                  !location.can.runCommands &&
                  !location.can.readFiles) &&
            table.projects.size == 1 &&
            replied refused == .inl .local &&
            after.workspaces == table) },
    { name :=
        "a main checkout and a linked worktree found once each are two workspaces of one project: a value in one's workspace store is not seen from the other's, and one in the project store is seen through both"
      run :=
        let mainAt := Location.local "/r"
        let worktreeAt := Location.local "/w"
        let (set, state) := recorded.handle (.setWorkspaceValue mainAt "x" (.nat 1))
        let identity := (state.workspaces.workspace? mainAt).map (·.project.identity)
        let shared := (state.workspaces.workspace? worktreeAt).map (·.project.identity)
        match identity with
        | none => pure false
        | some identity =>
          let (told, state) := state.handle (.setProjectValue identity "h" (.str "make"))
          let table := state.workspaces
          pure
            (replied set == .inr () && replied told == .inr () &&
              table.workspaceValue? mainAt "x" == some (.nat 1) &&
              table.workspaceValue? worktreeAt "x" == none &&
              shared == some identity &&
              table.projectValue? identity "h" == some (.str "make") &&
              table.workspaces.size == 2 &&
              table.projects.size == 1) },
    { name :=
        "a value for a workspace or a project there is none of is refused, noSuchWorkspace and noSuchProject, with the state as it was"
      run :=
        let (noWorkspace, kept) := recorded.handle (.setWorkspaceValue (.local "/z") "x" .null)
        let (noProject, held) := recorded.handle (.setProjectValue (.root "/z") "x" .null)
        pure
          (replied noWorkspace == .inl (.noSuchWorkspace (.local "/z")) &&
            replied noProject == .inl (.noSuchProject (.root "/z")) &&
            kept.workspaces == recorded.workspaces &&
            held.workspaces == recorded.workspaces) },
    { name :=
        "a workspace found again keeps its root, its project and its store, and takes the branch it now has"
      run :=
        let (_, stored) := recorded.handle (.setWorkspaceValue (.local "/r") "x" (.nat 1))
        let moved :=
          Workspace.Found.ofGit
            { toplevel := "/r", commonDir := "/r/.git", branch := .named "other" } (some origin)
        let again := request stored (.recordWorkspace "/r/lib" 0 (some moved))
        let workspace := again.workspaces.workspace? (.local "/r")
        pure
          ((workspace.map fun found => (found.branch, found.project.identity)) ==
              some (some (.named "other"), .commonDir "/r/.git") &&
            again.workspaces.workspaceValue? (.local "/r") "x" == some (.nat 1) &&
            again.workspaces.workspaces.size == 2) },
    { name :=
        "each directory's answer is cached under the generation it was found under, a directory with no workspace included, and is not an answer under another"
      run :=
        let none' := request recorded (.recordWorkspace "/x/" 0 none)
        let table := none'.workspaces
        pure
          (table.cached? "/r/src" 0 == some (some (.local "/r")) &&
            table.cached? "/r/src" 1 == none &&
            table.cached? "/x" 0 == some none &&
            table.cached? "/y" 0 == none) },
    { name :=
        "with no loop to answer, the workspace settings are config's defaults under generation 0"
      run := pure ((EditorState.none.handle .workspaceSettings).1 == ({}, 0)) },
    { name :=
        "a dispatched command that asks for the workspace settings is answered config's roots and the config generation the loop was told of"
      run :=
        let roots : Array Workspace.ConfigRoot := #[{ root := "/r/tools", project := some "tools" }]
        let registered : Loop.Registered := { workspaceRoots := roots, generation := 3 }
        let program : EditorM (Guarded (Workspace.Settings × Nat) × EditorState) := do
          (EditorState.ask .workspaceSettings).dispatched registered (← twoBuffers)
        pure <|
          match (program.runModel editorModel).1 with
          | .ok (.finished answer, _) => answer == ({ roots }, 3)
          | _ => false },
    { name :=
        "from a command: a buffer whose local value names a workspace has that workspace and its project; one that inherits from it has the same, and its working directory is the workspace's root; a buffer with none has no workspace and no working directory, and a store's value reads as its initial until it is set"
      run :=
        pure <|
          match
            dispatchedFrom do
              discard <| EditorState.ask (.recordWorkspace "/r/src" 0 (some main))
              discard <| one.setValue Workspace.bufferLocal (Location.local "/r").encode
              let found ← one.workspace?
              let none' ← (⟨0⟩ : BufferId).workspace?
              let before := (← editorState).workspaces.get countStore (.local "/r")
              let set ← Workspace.set countStore (.local "/r") 3
              let inherited ← (⟨0⟩ : BufferId).inheritWorkspace one
              return (found, none', before, set, inherited, ← (⟨0⟩ : BufferId).workspace?,
                  ← (⟨0⟩ : BufferId).workingDirectory) with
          | some ((found, none', before, set, inherited, after, directory), state) =>
            (found.map fun (workspace, project) => (workspace.location, project.identity)) ==
                some (.local "/r", .commonDir "/r/.git") &&
              none'.isNone &&
              before == 0 &&
              replied set == .inr () &&
              state.workspaces.get countStore (.local "/r") == 3 &&
              state.workspaces.get countStore (.local "/w") == 0 &&
              replied inherited == .inr () &&
              after == found &&
              directory == .workspace "/r"
          | none => false },
    { name :=
        "from a command: a buffer with no workspace and no file has no working directory, and the API's registration and project values are the state requests'"
      run :=
        pure <|
          match
            dispatchedFrom do
              let directory ← (⟨0⟩ : BufferId).workingDirectory
              let local' ← Workspace.register (.local "/r") origin none
              let registered ←
                Workspace.register (.branchOnly origin "agent/x") origin (some "agent/x")
              let told ← Project.setValue (.remote "github.com/o/r") "h" (.nat 2)
              let typed ← Project.set countStore (.remote "github.com/o/r") 5
              let unknown ← Workspace.setValue (.local "/z") "x" .null
              return (directory, local', registered, told, typed, unknown) with
          | some ((directory, local', registered, told, typed, unknown), state) =>
            directory == .none && replied local' == .inl .local && replied registered == .inr () &&
              replied told == .inr () &&
              replied typed == .inr () &&
              replied unknown == .inl (.noSuchWorkspace (.local "/z")) &&
              state.workspaces.projectValue? (.remote "github.com/o/r") "h" == some (.nat 2) &&
              state.workspaces.getOfProject countStore (.remote "github.com/o/r") == 5
          | none => false }]

/-- The `origin` of the repository of the workspace driver checks. -/
def workspaceOrigin : String :=
  "git@github.com:o/r.git"

/-- The world of the workspace driver checks: a main checkout at `/r` on
`main` and a linked worktree of it at `/w` on `feature`, both with
`workspaceOrigin`; `/x` is in no repository and holds no marker. -/
def workspaceWorld : Workspace.World :=
  { repositories :=
      #[{ toplevel := "/r", commonDir := "/r/.git", origin := some workspaceOrigin },
        { toplevel := "/w", commonDir := "/r/.git", branch := some "feature"
          origin := some workspaceOrigin }]
    markerDirectories := #["/r/.git"], markers := #["/w/.git"] }

/-- The jobs of the workspace driver checks: the find job and the file
command checks' jobs. -/
def workspaceJobs (name : String) : Option (List Argument → Work) :=
  if name == Workspace.findJob then some Workspace.findWork else fileJobs Files.limit name

/-- What a step of the workspace driver checks is handed: `C-o a`, `C-o b`
and `C-o c` open `a.lean`, `b.lean` and `c.lean` in `/r/src`, `C-o w`
opens `/w/src/b.lean` and `C-o x` opens `/x/a.txt`; `C-o i` runs
`workspace-current`; `C-o n` makes a buffer `made` that inherits the
workspace of the window's buffer, and a buffer `bare` that does not. -/
def workspaceKeys : Loop.Keys TestScheme.scheme :=
  dispatchKeys
    [("C-o a", opens "/r/src/a.lean"), ("C-o b", opens "/r/src/b.lean"),
      ("C-o c", opens "/r/src/c.lean"), ("C-o w", opens "/w/src/b.lean"),
      ("C-o x", opens "/x/a.txt"), ("C-o i", invoke Workspace.currentName),
      ("C-o n", invoke "inherit")]
    [(Files.openName, fun call => do
        Files.openCommand call
        return none),
      (Workspace.currentName, fun call => do
        Workspace.currentCommand call
        return none),
      ("inherit", fun call => do
        if let .ok made← createBuffer "made" then
          discard <| made.inheritWorkspace call.target.window.buffer
        discard <| createBuffer "bare"
        return none)]

/-- A driver with the keys of the workspace driver checks and the jobs
`registered`, whose jobs meet the processes and the files of
`workspaceWorld` for its three directories, with the files the keys open;
`none` if making the state was refused. -/
def workspaceDriver (registered : String → Option (List Argument → Work) := workspaceJobs) :
    Option TestDriver :=
  let model := workspaceWorld.jobModel "git" #["/r/src", "/w/src", "/x"]
  let files :=
    [("/r/src/a.lean", "a"), ("/r/src/b.lean", "b"), ("/r/src/c.lean", "c"), ("/w/src/b.lean", "w"),
          ("/x/a.txt", "x")].foldl
      (fun (files : FileModel) (path, text) => files.withFile path text.toUTF8) model.files
  (Loop.Driver.over workspaceKeys registered (EditorState.initial ⟨640, 480⟩)
        editorModel).toOption.map
    fun driver => { driver with jobs := { model with files } }

/-- `driver` once `keys` are pressed and every job they start, and every job
those jobs' commands start, is finished, oldest first. -/
def settledAfter (driver : TestDriver) (keys : String) : TestDriver :=
  (List.range 8).foldl
    (fun driver _ =>
      match driver.pending[0]? with
      | some job => (driver.finish job.id).1
      | none => driver)
    (fedTo driver (presses keys)).1

/-- The workspace of the buffer the view 0 of `driver` shows, and its
project. -/
def shownWorkspace (driver : TestDriver) : Option (Workspace × Project) := do
  driver.loop.state.workspaceOf? (← showing driver).id

/-- The two git commands the finder runs in `directory`. -/
def gitAsked (directory : System.FilePath) : Array Process.Command :=
  #[Workspace.Git.revParseCommand "git" directory, Workspace.Git.originCommand "git" directory]

/-- The checks of a buffer's workspace (`Editor/Workspace/Attach.lean`), on
the loop's driver over the editor's models and the job model of
`workspaceWorld`. -/
def workspaceChecks : List Check :=
  [{  name :=
        "a file under /r/src opens into a buffer whose workspace has root /r, branch main and location local /r, and whose project is identified by the normalised origin, with the common git directory /r/.git"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let opened := settledAfter driver "C-o a"
            (shownWorkspace opened).map
                (fun (workspace, project) =>
                  (workspace.location, workspace.branch, project.identity, project.commonDir,
                    project.remote)) ==
              some
                (.local "/r", some (.named "main"), .remote "github.com/o/r",
                  some ("/r/.git" : System.FilePath), some workspaceOrigin) },
    { name :=
        "a file in the linked worktree /w has workspace root /w and branch feature, of the same project as /r's: two workspaces, each with its own store, and one project, with one store"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let main := settledAfter driver "C-o a"
            let both := settledAfter main "C-o w"
            let state := both.loop.state
            match shownWorkspace main, shownWorkspace both with
            | some (first, project), some (second, shared) =>
              let (_, state) := state.handle (.setWorkspaceValue first.location "x" (.nat 1))
              let (_, state) := state.handle (.setProjectValue project.identity "h" (.nat 2))
              second.location == .local "/w" && second.branch == some (.named "feature") &&
                shared == project &&
                state.workspaces.workspaceValue? second.location "x" == none &&
                state.workspaces.workspaceValue? first.location "x" == some (.nat 1) &&
                state.workspaces.projectValue? shared.identity "h" == some (.nat 2) &&
                state.workspaces.workspaces.size == 2 &&
                state.workspaces.projects.size == 1
            | _, _ => false },
    { name :=
        "with no adapter answering, a buffer has no workspace, and workspace-current says so, naming the file's directory"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let opened := settledAfter driver "C-o x"
            let asked := settledAfter opened "C-o i"
            (shownWorkspace opened).isNone &&
              (showing opened).map (·.buffer.name) == some "a.txt" &&
              echoOf asked == some (Workspace.noWorkspace "/x") },
    { name :=
        "two open workspaces of one project are labelled name@branch, and workspace-current in /r's buffer says its label, location, branch and what it can do, its project's name and identity, and the project's other open workspace by label"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let both := settledAfter (settledAfter driver "C-o a") "C-o w"
            let back := settledAfter both "C-o a"
            let asked := settledAfter back "C-o i"
            match showing back, shownWorkspace back, shownWorkspace both with
            | some shown, some (main, _), some (worktree, _) =>
              let current := Workspace.current back.loop.state shown.id
              main.label == "r@main" && worktree.label == "r@feature" &&
                back.loop.state.workspaces.others main == #[worktree] &&
                current ==
                  .workspace
                    { label := "r@main", location := .local "/r", branch := some (.named "main")
                      can := (Location.local "/r").can, projectName := "r"
                      identity := .remote "github.com/o/r", others := #["r@feature"] } &&
                echoOf asked == some current.text
            | _, _, _ => false },
    { name :=
        "with one open workspace of its project, workspace-current says the buffer's workspace and lists no other"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let opened := settledAfter driver "C-o a"
            let asked := settledAfter opened "C-o i"
            match showing opened with
            | some shown =>
              let current := Workspace.current opened.loop.state shown.id
              current ==
                  .workspace
                    { label := "r@main", location := .local "/r", branch := some (.named "main")
                      can := (Location.local "/r").can, projectName := "r"
                      identity := .remote "github.com/o/r", others := #[] } &&
                echoOf asked == some current.text
            | none => false },
    { name :=
        "a second file in the same directory asks git nothing and starts no find job, and has the workspace; once a reload has installed a new generation, the next file asks git again"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let first := settledAfter driver "C-o a"
            let second := settledAfter first "C-o b"
            let reloaded :=
              { second with
                keys :=
                  { second.keys with
                    registered := { second.keys.registered with generation := 1 } } }
            let third := settledAfter reloaded "C-o c"
            first.jobs.processes.started == gitAsked "/r/src" &&
              second.jobs.processes.started == gitAsked "/r/src" &&
              second.next == first.next + 1 &&
              (shownWorkspace second).map (·.1.location) == some (.local "/r") &&
              third.jobs.processes.started == gitAsked "/r/src" ++ gitAsked "/r/src" &&
              (shownWorkspace third).map (·.1.location) == some (.local "/r") },
    { name :=
        "a buffer made from a buffer with a workspace inherits it, and one made without inheriting has none"
      run :=
        pure <|
          match workspaceDriver with
          | none => false
          | some driver =>
            let made := settledAfter (settledAfter driver "C-o a") "C-o n"
            let state := made.loop.state
            match state.findBuffer "made", state.findBuffer "bare" with
            | some inherited, some bare =>
              (state.workspaceOf? inherited).isSome &&
                state.workspaceOf? inherited == shownWorkspace made &&
                (state.workspaceOf? bare).isNone
            | _, _ => false },
    { name :=
        "with no find job registered, a file still opens, its buffer has no workspace, and nothing is said"
      run :=
        pure <|
          match workspaceDriver (fileJobs Files.limit) with
          | none => false
          | some driver =>
            let opened := settledAfter driver "C-o a"
            (showing opened).map (·.buffer.name) == some "a.lean" &&
              (shownWorkspace opened).isNone &&
              echoOf opened == some "" &&
              opened.jobs.processes.started.isEmpty },
    { name :=
        "a find order crosses as arguments and back, its roots with and without a project, and arguments that are no order read as none; the find job started with them fails"
      run :=
        let orders : List Workspace.FindOrder :=
          [{ buffer := ⟨1⟩, directory := "/r/src", generation := 0 },
            { buffer := ⟨4⟩, directory := "/a b/é", git := "/usr/bin/git", generation := 7
              roots := #[{ root := "/r/tools", project := some "tools" }, { root := "/notes" }] }]
        pure
          (orders.all
              (fun order => Workspace.FindOrder.ofArguments? order.arguments == some order) &&
            [[], [.nat 1, .str "/r"], [.nat 1, .str "/r", .str "git", .nat 0, .str "/t"]].all
              (Workspace.FindOrder.ofArguments? · == none) &&
            ((Workspace.findWork [.nat 1] ()).runModel {}).1 matches .failed _) }]

/-- The names of the workspace finder's contract properties
(`Editor/Workspace/Contract.lean`) that do not hold of the pure model
(`World.find`), or of the real finder run on the job model of the
property's world (`World.jobModel`); and, for a property that must not ask
git, of a run that started a process. -/
def workspaceFinderFailures : IO (List String) :=
  pure <|
    (Workspace.FinderContract.properties "/").flatMap fun property =>
      let settings := property.settings "git"
      let directories := property.asked.map (·.1)
      let byModel := property.asked.map fun (directory, _) => property.world.find settings directory
      let (outcome, after) :=
        (property.answers "git").runModel (property.world.jobModel "git" directories)
      (if byModel == property.expected then []
        else [s!"the workspace finder's model: {property.name}"]) ++
        (if outcome == .finished property.expected then []
        else [s!"the workspace finder on the job model: {property.name}"]) ++
        if property.asksGit || after.processes.started.isEmpty then []
        else [s!"the workspace finder on the job model starts no process: {property.name}"]

/-- Every check, in the order they run.

The order matters where the process's one pool is measured. `poolChecks` run
first, on a pool nothing has used. Within `runnerChecks`, the check that
counts the threads jobs wait from comes before any check that holds a job in
pure code on a promise: pure code blocked in `Task.get` on a pool thread
makes Lean add a thread to the pool, which a later burst can land on. -/
def checks : List Check :=
  poolChecks ++ programChecks ++ jobModelChecks ++ waitChecks ++ runnerChecks ++ tableChecks ++
    ownerChecks ++
    fileRunnerChecks ++
    processChecks ++
    processEnvironmentChecks ++
    environmentLookupChecks ++
    fileWatchModelChecks ++
    fileWatchRunnerChecks ++
    setupChecks ++
    registryChecks ++
    storeChecks ++
    sessionChecks ++
    reloadChecks ++
    windowTallyChecks ++
    windowLoopChecks ++
    windowArgumentChecks ++
    moduleLookupChecks ++
    headlessCommandLineChecks ++
    executableModeChecks ++
    windowOptionChecks ++
    windowStartChecks ++
    windowReportChecks ++
    undoTreeChecks ++
    textModelStepChecks ++
    fileModelChecks ++
    sceneChecks ++
    modeLineChecks ++
    paddingChecks ++
    faceChecks ++
    displayChecks ++
    frameDisplayChecks ++
    commandPortChecks ++
    watchChecks ++
    clipboardChecks ++
    fuzzyChecks ++
    guardChecks ++
    scrollChecks ++
    originChecks ++
    heightChecks ++
    layoutChecks ++
    stateChecks ++
    stateRequestChecks ++
    loopChecks ++
    commitChecks ++
    keymapChecks ++
    keyNotationChecks ++
    invocationChecks ++
    exLineChecks ++
    schemeChecks ++
    schemeContractChecks ++
    dispatchChecks ++
    vimEditChecks ++
    vimRegistryChecks ++
    vimGrammarChecks ++
    vimStateChecks ++
    vimDefaultChecks ++
    vimContractChecks ++
    modeRecordChecks ++
    modeRegistryChecks ++
    modeDispatchChecks ++
    modeEnterChecks ++
    apiStateChecks ++
    driverChecks ++
    promptChecks ++
    candidateChecks ++
    fileCommandChecks ++
    openFilesChecks ++
    dispatchQuitChecks ++
    systemQuitChecks ++
    exChecks ++
    fileReloadChecks ++
    stalenessChecks ++
    autoReloadChecks ++
    bufferCommandChecks ++
    themeChecks ++
    appearanceChecks ++
    faceVocabularyChecks ++
    solarizedChecks ++
    fairyFlossChecks ++
    evilRestChecks ++
    evilMotionChecks ++
    evilStateChecks ++
    evilInsertChecks ++
    evilOperatorChecks ++
    evilFindChecks ++
    evilSearchChecks ++
    searchDecorationChecks ++
