    ("f c ; ; ,", "|abcabcabc", "abcab|cabc"), (";", "|abc", "|abc"), (",", "|abc", "|abc"),
    ("f z ;", "|abz", "ab|z"), ("2 f é", "|aébé", "aéb|é"), ("f é", "|aébé", "a|ébé"),
    ("f 1", "|a1b1", "a|1b1"), ("2 f 1", "|a1b1", "a1b|1"), ("f TAB", "|a\tb", "a|\tb"),
