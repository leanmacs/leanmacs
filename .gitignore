/target
# Lake's build output and fetched packages, in any Lake package: the core
# (lean/), the formatter's host (tools/lean-fmt/), the package sets and the
# packages (packages/, tests/packages/).
.lake/
/research_notes
/reports
/.claude/worktrees
# lean-fmt's cache, which it writes in the root of each package it is run
# over.
.lean-fmt-cache
/.linux-ci
# infra/github's OpenTofu working files. The state is encrypted but still
# never committed; .terraform.lock.hcl is committed.
/infra/github/.terraform/
/infra/github/*.tfstate
/infra/github/*.tfstate.*
/infra/github/*.tfplan
/infra/github/.terraform.tfstate.lock.info
/infra/github/crash*.log
/dist
# macOS Finder metadata, in any directory.
.DS_Store
