amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// The C and C++ sources: the glue between Lean and the Rust library.
local c_sources = List("**/*.c", "**/*.h", "**/*.cc", "**/*.cpp", "**/*.hpp")

// What the Rust static library is built from.
local rust_sources = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")

// What the workflow lint reads (mise.toml's `workflow-lint` task): the
// workflows and zizmor's config (.github), and mise.toml, which defines the
// task.
local workflow_sources = List(".github/**", "mise.toml")

// The whole gate, defined once in mise.toml's `ci` task, which both hooks
// run: `hk run pre-commit` and `hk check` each have this one step, chosen
// by its glob and nothing else, and pass or fail by `mise run ci`'s exit
// status (docs/dev-practices/the-gate.md, "The pre-commit hook"). The glob
// is every file the gate reads: the crates and the vendored grammar they
// build from (`crates/**`, `vendor/**`: queries, shaders and grammar files
// beside the Rust), the Lean core, the package sets and the fixtures, the
// default config, the guide's example package (`docs/packages/*/**`, which
// the fixture set requires), every script the gate runs (`tools/**`), what
// the bundle steps stage (`packaging/**`), the tools' configs and this
// file. A commit that stages nothing else (the docs, README.md, .agents/,
// infra/ outside the workflow lint's file) runs no step. Narrower,
// graph-based selection is rdm task build-graph-test-selection-tool.
local ci = new Mapping<String, Step> {
    ["mise_ci"] {
        glob = rust_sources + c_sources + workflow_sources + List("crates/**", "vendor/**", "deny.toml", "clippy.toml", ".clang-format", "hk.pkl", "lean/**", "packages/**", "tests/**", "config/**", "docs/packages/*/**", "tools/**", "packaging/**")
        check = "mise run ci"
        exclusive = true
    }
}

// Check-only: the hooks report problems but never rewrite staged files.
hooks {
    ["pre-commit"] {
        steps = ci
    }
    ["check"] {
        steps = ci
    }
}
