amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// The C and C++ sources: the glue between Lean and the Rust library.
local c_sources = List("**/*.c", "**/*.h", "**/*.cc", "**/*.cpp", "**/*.hpp")

// What the Rust static library is built from.
local rust_sources = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")

// What the workflow lint reads (mise.toml's `workflow-lint` task): the
// workflows and zizmor's config (.github), the structural check and its
// probe (tools/workflow-*.sh), the probe's fixtures (tests/workflow-lint),
// and the files tools/workflow-check.sh compares ci.yml with:
// tools/linux/Dockerfile (MISE_VERSION, ELAN_VERSION), mise.toml ([tools]),
// infra/github/actions.tf (patterns_allowed) and tools/ci/install-elan.sh
// (ELAN_VERSION). mise.ci.toml is not here: the lint never reads it, and
// only the CI job (MISE_ENV=ci) does, so no local step checks a change to it.
local workflow_sources = List(".github/**", "tools/workflow-*.sh", "tests/workflow-lint/**", "tools/linux/Dockerfile", "mise.toml", "infra/github/actions.tf", "tools/ci/**")

// The full gate, defined once in mise.toml's `ci` task.
local ci = new Mapping<String, Step> {
    ["mise_ci"] {
        glob = rust_sources + c_sources + workflow_sources + List("deny.toml", "**/clippy.toml", ".clang-format", "lean/**", "tests/**", "tools/stage-bundle.sh")
        check = "mise run ci"
        exclusive = true
    }
}

// The pre-commit gate: only the steps whose files are staged. `exclusive`
// runs them one after another rather than contending for the target-dir
// lock. Rustdoc and cargo-deny are left to the full gate (`hk check`,
// `mise run ci`), run before review and on landing.
local changed = new Mapping<String, Step> {
    ["fmt"] {
        glob = List("**/*.rs")
        check = "mise run fmt"
        exclusive = true
    }
    // A crate's `clippy.toml` lists what the crate may not name (real files,
    // processes, clocks), so a commit that changes only a list still runs
    // the lint.
    ["rust"] {
        glob = rust_sources + List("mise.toml", "**/clippy.toml")
        check = "mise run lint && mise run test"
        exclusive = true
    }
    ["c"] {
        glob = c_sources + List(".clang-format", "mise.toml")
        check = "mise run c-fmt"
        exclusive = true
    }
    // Lake links the Rust static library and the C glue into the executables
    // `ffi-test` runs, so a change to either reruns this step. `tests/` holds
    // the fixture `ffi-test` runs the editor's headless mode on.
    ["lean"] {
        glob = rust_sources + c_sources + List("lean/**", "tests/**", "mise.toml")
        check = "mise run lean-fmt && mise run ffi-test"
        exclusive = true
    }
    ["workflows"] {
        glob = workflow_sources
        check = "mise run workflow-lint"
        exclusive = true
    }
}

// Check-only: the hooks report problems but never rewrite staged files.
hooks {
    ["pre-commit"] {
        steps = changed
    }
    ["check"] {
        steps = ci
    }
}
