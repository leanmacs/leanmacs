amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// The C and C++ sources: the glue between Lean and the Rust library.
local c_sources = List("**/*.c", "**/*.h", "**/*.cc", "**/*.cpp", "**/*.hpp")

// What the Rust static library is built from.
local rust_sources = List("**/*.rs", "**/Cargo.toml", "Cargo.lock")

// What the workflow lint reads (mise.toml's `workflow-lint` task): the
// workflows and zizmor's config (.github), the structural check and its
// probe (tools/workflow-*.sh), the probe's fixtures (tests/workflow-lint),
// and the files tools/workflow-check.sh compares the workflows with:
// tools/linux/Dockerfile (MISE_VERSION, ELAN_VERSION), mise.toml ([tools]),
// infra/github/actions.tf (patterns_allowed) and tools/ci/install-elan.sh
// (ELAN_VERSION).
local workflow_sources = List(".github/**", "tools/workflow-*.sh", "tests/workflow-lint/**", "tools/linux/Dockerfile", "mise.toml", "infra/github/actions.tf", "tools/ci/**")

// The full gate, defined once in mise.toml's `ci` task.
local ci = new Mapping<String, Step> {
    ["mise_ci"] {
        glob = rust_sources + c_sources + workflow_sources + List("deny.toml", "**/clippy.toml", ".clang-format", "lean/**", "packages/**", "tests/**", "config/**", "tools/stage-bundle.sh")
        check = "mise run ci"
        exclusive = true
    }
}

// The pre-commit gate: only the steps whose files are staged. `exclusive`
// runs them one after another rather than contending for the target-dir
// lock. Rustdoc and cargo-deny are left to the full gate (`hk check`,
// `mise run ci`), run before review and on landing.
local changed = new Mapping<String, Step> {
    ["fmt"] {
        glob = List("**/*.rs")
        check = "mise run fmt"
        exclusive = true
    }
    // A crate's `clippy.toml` lists what the crate may not name (real files,
    // processes, clocks), so a commit that changes only a list still runs
    // the lint. Which crates the lint and the tests run over is decided by
    // tools/rust-targets.sh from Cargo's graph, which lists the same
    // patterns as this glob: a change inside a crate's directory runs that
    // crate's and its dependents', any other the whole workspace's
    // (docs/dev-practices/the-gate.md, "The pre-commit hook").
    ["rust"] {
        glob = rust_sources + List("mise.toml", "**/clippy.toml", "tools/rust-targets.sh", "tools/graph-targets.sh", "tools/rust-hook.sh", "tests/rust-targets/**")
        check = "sh tools/rust-hook.sh {{files}}"
        exclusive = true
    }
    ["c"] {
        glob = c_sources + List(".clang-format", "mise.toml")
        check = "mise run c-fmt"
        exclusive = true
    }
    // Lake links the Rust static library and the C glue into the executables
    // `ffi-test` runs, so a change to either reruns this step. `packages/`
    // holds the default package set the editor is built from, `tests/` the
    // fixture `ffi-test` runs the editor's headless mode on and the fixture
    // package set, `config/` the default config `config-test` loads, and
    // a directory under `docs/packages/` the guide's example package, which
    // the fixture set requires.
    // What the step runs for the staged files is decided by
    // tools/hook-targets.sh, which owns the decision and lists the same
    // patterns as this glob: a change inside one package's directory runs
    // that package's checks (and, for an interface package, those of the
    // packages that require it), any other runs the core's chain and every
    // package's (docs/dev-practices/the-gate.md, "The pre-commit hook").
    // The packages come from Lake's graph, so a new package needs no edit
    // here.
    ["lean"] {
        glob = rust_sources + c_sources + List("lean/**", "packages/**", "tests/**", "config/**", "docs/packages/*/**", "mise.toml", "tools/hook-targets.sh", "tools/graph-targets.sh", "tools/lean-hook.sh", "tools/package-set.sh")
        check = "sh tools/lean-hook.sh {{files}}"
        exclusive = true
    }
    ["workflows"] {
        glob = workflow_sources
        check = "mise run workflow-lint"
        exclusive = true
    }
}

// Check-only: the hooks report problems but never rewrite staged files.
hooks {
    ["pre-commit"] {
        steps = changed
    }
    ["check"] {
        steps = ci
    }
}
