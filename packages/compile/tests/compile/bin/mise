#!/bin/sh
# Stands for `mise` in the compile package's linked test, in its checks
# of the shipped modes over the real process service
# (packages/compile/CompileTest/Linked/Compile/Shipped.lean,
# projectRunChecks, which were contract-test's projectModeChecks until the
# compile mode moved out of the core), found first on the child's PATH.
# `mise tasks ls --json` prints a JSON array of two tasks, `build` and
# `test`, each with the directory it runs in (`pwd -P`) as its `dir` and a
# few other fields, as mise does; `mise run <task>` with a file
# `mise-run-<task>.txt` beside this script writes its lines to standard
# error and exits 1; anything else says what it expected and exits 2. Shell
# builtins only, so it runs whatever PATH it is given.

here=${0%/*}

if [ "$#" -eq 3 ] && [ "$1" = tasks ] && [ "$2" = ls ] && [ "$3" = --json ]; then
  dir=$(pwd -P)
  printf '[\n'
  printf '  {"name": "build", "dir": "%s", "hide": false, "depends": [], "run": ["cargo build"]},\n' "$dir"
  printf '  {"name": "test", "dir": "%s", "hide": false, "depends": ["build"], "run": ["cargo test"]}\n' "$dir"
  printf ']\n'
  exit 0
fi

if [ "$#" -eq 2 ] && [ "$1" = run ] && [ -f "$here/mise-run-$2.txt" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
  done <"$here/mise-run-$2.txt" >&2
  exit 1
fi

printf 'mise fixture: expected tasks ls --json or run <task>, got: %s\n' "$*" >&2
exit 2
