# The leave-out check's hand-written lakefile (tools/leave-out-check.sh;
# docs/dev-practices/the-gate.md, "The leave-out check"): a set of three
# packages and the core, shaped as the default set's (packages/lakefile.toml),
# over which `mise run lean-test` runs the check's dry run and compares what
# it prints with `without-beta` (a package in the middle) and
# `without-gamma` (the last), the root given as `/repo/set`. Nothing is
# built from it and Lake never reads it: no directory it names exists.
name = "leave-out-set"

[[require]]
name = "editor-core"
path = "/repo/lean"

# The first package: a comment of two lines
# directly above its require goes with it.
[[require]]
name = "alpha"
path = "/repo/set/alpha"

# The package in the middle.
[[require]]
name = "beta"
path = "/repo/set/beta"

# This comment is no require's: a blank line parts it from the next.
