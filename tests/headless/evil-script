# The script `mise run ffi-test` has the editor's headless mode run against
# the config in `config/`, of which it loads nothing: there is no `reload`.
# So every command it runs is one the editor ships, compiled in. What it
# prints must be exactly `evil-expected`.

# `i` begins an insert, and each key that prints is typed text. The scene
# shows the text, the bar after it, and the state's name first in the
# status line. The buffer is modified.
key i KeyI -
key h KeyH -
key e KeyE -
key l KeyL -
key l KeyL -
key o KeyO -
scene

# `<Escape>` returns to normal state: the cursor is on the last character
# typed, one cell back from the bar.
key <Escape> Escape -
scene

# `0` is a motion in normal state: the cursor goes to the line's start.
key 0 Digit0 -
scene

# Slash asks for a pattern in the minibuffer, whose view is printed after
# the window's with the prompt's label as its status line; Enter accepts
# it, and the search, answered by the library's engine, moves the cursor to
# the first l after it. The view's matches are drawn in search-match.
key / Slash -
key l KeyL -
scene
key <Enter> Enter -
scene

# n goes on to the next match, and N comes back, by the last search.
key n KeyN -
scene
key N KeyN shift
scene

# `A` appends at the line's end, and a pair typed there is text. `%` from
# the closing bracket goes back to the opening one, by the library's walk.
key A KeyA shift
key ( Digit9 shift
key a KeyA -
key ) Digit0 shift
key <Escape> Escape -
key % Digit5 shift
scene

# `d i (` deletes inside the pair the cursor is on: the operator over the
# text object `inner-paren`, which normal state's keys reach only while an
# operator waits. The cursor rests on the closing bracket.
key d KeyD -
key i KeyI -
key ( Digit9 shift
scene
