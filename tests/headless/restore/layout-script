# A template of a script: `mise run ffi-test` copies `note.txt` into a
# temporary directory, writes this file there with `@FILE@` replaced by the
# copy's absolute path, and runs it against `layout-config/` with `--state`
# naming a fresh directory beside it. It makes two tabs of windows, records
# jumps, types, waits until the session index and the journal are written
# (`indexed`, `journalled`) and aborts: the process ends with the status 134
# and no shutdown. `layout-restore-script`, run next with the same
# `--state`, restores them. What it prints must be exactly `layout-expected`,
# the temporary directory read as `@DIR@`.

reload
settle
resize 640 480

# `:e` opens the file; its load and its workspace's finder are jobs, and
# each change they make starts a write of the index, which waits on the
# clock: `indexed` moves the clock past each and waits for them all.
key : Semicolon shift
commit e @FILE@
key <Enter> Enter -
indexed

# Three tiles under manual splits, one split resized.
run window-split-vertically
run window-split
run window-wider

# A fourth window docked at the left edge, and, the focus moved to a tile,
# a tile made a float.
run window-split
run window-edge-left
run window-focus-next
run window-float

# `G` and `gg` record jumps in the focused window.
key G KeyG shift
key g KeyG -
key g KeyG -

# `C-w c` makes a second tab; `C-c r`, `notes` and `<Enter>` rename it;
# `C-w s C-w z` splits it and zooms the new window.
key w KeyW control
key c KeyC -
key c KeyC control
key r KeyR -
commit notes
key <Enter> Enter -
key w KeyW control
key s KeyS -
key w KeyW control
key z KeyZ -

# `C-w p` goes back to the first tab.
key w KeyW control
key p KeyP -

# Typed in insert state, so the file's text is unsaved.
key i KeyI -
key x KeyX -
key <Escape> Escape -
indexed
journalled
scene
settle
abort
