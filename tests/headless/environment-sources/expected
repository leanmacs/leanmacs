reload 1: installed, 1 files, 1 commands
run layers: ok
scene 0x0, focused 0, echo "window: base login-shell in /u, probed by /usr/bin/printenv SHELL, /usr/bin/id -P, else /bin/zsh; mise first of /u/.local/bin/mise, /opt/homebrew/bin/mise, /usr/local/bin/mise, else skip | headless: base inherited; none", echo padding 8, preedit -, theme "default"
view 0 0,0 0x0: "", scroll 0, selections 0..0, padding 8 8
status 0 in mode-line.active: mode-line.state.normal "NORMAL" +8, mode-line.buffer "scratch" +4 | mode-line.secondary "1:1" +4, mode-line.secondary "All" +4
