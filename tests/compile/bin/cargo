#!/bin/sh
# Stands for `cargo` in contract-test's checks of the shipped modes
# (lean/ContractTest.lean, projectModeChecks), found first on the child's
# PATH. `cargo build` writes the lines of `cargo-build.txt`, beside this
# script, to standard error, as cargo writes rustc's errors, and exits 101;
# anything else says what it expected and exits 2. Shell builtins only, so
# it runs whatever PATH it is given.

here=${0%/*}

if [ "$#" -eq 1 ] && [ "$1" = build ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
  done <"$here/cargo-build.txt" >&2
  exit 101
fi

printf 'cargo fixture: expected build, got: %s\n' "$*" >&2
exit 2
