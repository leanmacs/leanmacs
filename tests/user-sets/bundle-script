# The script of tools/bundle-sets.sh, run by `mise run bundle-test` and
# `mise run app-check` through a bundle's launcher, with `@HELLO@` a copy
# of the fixture package `hello-init` that requires the bundle's core.
# Three processes run it, each going on after the last `restarted` the one
# before passed. The config directory holds the lakefile a first launch
# generated, naming the bundle's set, and `init.lean`, which imports
# `HelloInit`.

# P1, the shipped default: the config is refused; installing hello-init
# builds the set from the bundle and restarts into version 1.
reload
settle
resize 640 480
key : Semicolon shift
commit package-install hello-init @HELLO@
key <Enter> Enter -
restarted 300

# P2, version 1: the config installs and the package's command answers;
# dropping the default package compile builds version 2.
settle
reload
settle
resize 640 480
run hello-init
scene
key : Semicolon shift
commit package-remove compile
key <Enter> Enter -
restarted 300

# P3, version 2: compile is gone, hello-init is still there.
settle
reload
settle
resize 640 480
run compile
run hello-init
scene
