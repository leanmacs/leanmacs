;; The sandbox of the user-side link check (tools/user-link-check.sh;
;; docs/design/lean-runtime.md, "A link on the user's machine, measured"):
;; what a build on a Mac that never had the Xcode command line tools can
;; reach, on a machine that has them.
;;
;;   sandbox-exec -f tools/user-link/sandbox.sb -D STAGE=<dir> -D WORK=<dir> <program> ...
;;
;; STAGE is the directory of the staged pieces and WORK the check's
;; temporary directory, which holds it; both as real paths, with no symbolic
;; link in them, since the rules below match the path a file resolves to.
;;
;; A later rule wins over an earlier one. The check's probe (its step 2)
;; shows each denial below holds before anything is built under it.
(version 1)
(allow default)

;; No program outside the stage runs: not `/usr/bin/xcrun`, `/usr/bin/cc`,
;; `/usr/bin/clang`, `/usr/bin/ld` or `/usr/bin/git`, which on a Mac without
;; the tools are shims that open the install prompt, and not `/bin/sh` or
;; `/usr/bin/env` either.
(deny process-exec)
(allow process-exec (subpath (param "STAGE")))

;; Nothing a developer's machine has beyond the base system is readable:
;; Xcode and its SDKs (/Applications), the command line tools and their SDK
;; (/Library/Developer), Homebrew and other installs (/opt, /usr/local), and
;; every home directory, with the real Lean toolchain, Cargo, and this
;; repository in them (/Users).
(deny file-read*
  (subpath "/Applications")
  (subpath "/Library/Developer")
  (subpath "/opt")
  (subpath "/usr/local")
  (subpath "/Users"))

;; The check's own temporary directory stays readable and writable wherever
;; it is, under a home directory too.
(allow file-read* file-write* (subpath (param "WORK")))
